---
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const translatePath = useTranslatedPath(lang);
---
<div class="eco-bar" id="ecoBar">
  <div class="wrap eco-bar-inner">
    <span class="eco-bar-label">Bagian dari ekosistem Cardi</span>
    <div class="eco-bar-nav" role="navigation" aria-label="Ekosistem Cardi">
      <a href={translatePath('/')} class="active" aria-current="page">Cardi</a>
      <span class="eco-bar-sep">·</span>
      <a href="https://cardinusantara.com/" target="_blank" rel="noopener">Cardi Nusantara</a>
      <span class="eco-bar-sep">·</span>
      <a href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener">Cardi Agent</a>
      <span class="eco-bar-sep">·</span>
      <a href={translatePath('/toko')}>Toko Cardi</a>
    </div>
  </div>
</div>

<style>
  .eco-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 220;
    background: #060B18;
    color: #94A3B8;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 11.5px;
    font-weight: 500;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .eco-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .eco-bar-label {
    color: #64748B;
    font-size: 11px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .eco-bar-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .eco-bar-nav a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
    font-size: 11.5px;
  }

  .eco-bar-nav a:hover,
  .eco-bar-nav a.active {
    color: #38BDF8;
  }

  .eco-bar-sep {
    color: rgba(255, 255, 255, 0.2);
    user-select: none;
  }

  @media (max-width: 640px) {
    .eco-bar {
      padding: 6px 0;
      font-size: 10.5px;
    }
    .eco-bar-label {
      display: none;
    }
    .eco-bar-inner {
      justify-content: center;
      padding: 0 10px;
    }
    .eco-bar-nav {
      gap: 7px;
      font-size: 10.5px;
    }
    .eco-bar-nav a {
      font-size: 10.5px;
    }
  }
</style>
