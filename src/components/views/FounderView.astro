  { source: "Liputan6", title: "Seblak dengan rasa internasional", href: "https://www.liputan6.com/citizen6/read/4527173/pencinta-pedas-wajib-coba-seblak-dengan-kreasi-baru-citarasa-internasional" },
  { source: "Tribunnews", title: "Live.On milik XL Axiata terima penghargaan", href: "https://www.tribunnews.com/techno/2020/12/07/liveon-ajak-siapa-saja-bebas-berinternet-tanpa-was-was-batasan-kuota" },
  { source: "Warta Ekonomi", title: "Seblak Blakan, makanan kekinian", href: "https://wartaekonomi.co.id/read335471/seblak-blakan-makanan-kekinian-dengan-rasa-internasional" },
  { source: "Warta Ekonomi", title: "Goerengan, jajanan pasar naik kelas", href: "https://wartaekonomi.co.id/read328796/goerengan-jajanan-pasar-yang-naik-kelas" },
  { source: "Fimela", title: "Snack Korea di Jakarta", href: "https://www.fimela.com/lifestyle/read/4357994/merasakan-snack-korea-di-jakarta-milik-jovi-adhiguna" },
  { source: "KapanLagi", title: "Minuman boba kekinian 2020", href: "https://www.kapanlagi.com/showbiz/selebriti/terjun-ke-dunia-bisnis-keanu-agl-jualan-minuman-boba-169b44.html" },
  { source: "DAAI TV", title: "DTS community di Halo Indonesia", href: "https://www.youtube.com/watch?v=1GvHgasNmBo" },
  { source: "Tech in Asia", title: "4 startup teknologi Indonesia minggu ini (2015)", href: "https://id.techinasia.com/berita-startup-teknologi-di-indonesia-7-november-2015" }
];
---

<Layout title={c.metaTitle} description={c.metaDesc} lang={lang}>
  <!-- Schema.org Person JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Deo Cardi Nathanael",
    "alternateName": "Deo Cardi",
    "jobTitle": "Founder & CEO",
    "worksFor": {
      "@type": "Organization",
      "name": "Cardi Nusantara",
      "legalName": "PT Digital Cardi Nusantara",
      "url": "https://www.cardi.co.id/"
    },
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "BINUS University"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Jakarta",
      "addressCountry": "ID"
    },
    "url": "https://cardi.co.id/deo-cardi-nathanael-profile/",
    "sameAs": [
      "https://deo.cardinusantara.com/",
      "https://www.linkedin.com/in/deocardi/",
      "https://www.instagram.com/deo_cardi/",
      "https://www.tiktok.com/@deo_cardi",
      "https://www.youtube.com/deocardi"
    ],
    "knowsAbout": [
      "Brand Development",
      "Brand Strategy",
      "Digital Marketing",
      "Business Development",
      "F&B Branding",
      "AI Agent for Business"
    ]
  })} />

  <Navbar lang={lang} />

  <main id="main" class="founder-page">
    <!-- HERO SECTION -->
    <section class="founder-hero">
      <div class="wrap">
        <!-- In-page language switcher pill -->
        <div class="lang-bar">
          <span class="lang-label">Language:</span>
          <div class="lang-pills">
            <a href="/deo-cardi-nathanael-profile" class={`lang-chip ${currentLang === 'id' ? 'active' : ''}`}>ID</a>
            <a href="/en/deo-cardi-nathanael-profile" class={`lang-chip ${currentLang === 'en' ? 'active' : ''}`}>EN</a>
            <a href="/zh/deo-cardi-nathanael-profile" class={`lang-chip ${currentLang === 'zh' ? 'active' : ''}`}>中文</a>
          </div>
        </div>

        <div class="hero-grid">
          <div class="hero-content">
            <span class="kicker">{c.kicker}</span>
            <h1 class="founder-title">
              {c.nameFirst} <span class="highlight">{c.nameLast}</span>
            </h1>
            <p class="lead">{c.lead}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={waUrl} target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/>
                </svg>
                <span>{c.btnWa}</span>
              </a>
              <a class="btn btn-secondary" href="https://www.youtube.com/c/DeoCardi" target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
                <span>{c.btnAcademy}</span>
              </a>
            </div>
          </div>

          <div class="hero-photo-wrap">
            <figure class="founder-photo-card">
              <img 
                src="/images/deo-cardi-nathanael.jpg" 
                alt="Deo Cardi Nathanael — Founder & CEO Cardi Nusantara" 
                width="420" 
                height="490" 
                loading="eager"
              />
              <figcaption class="photo-badge">
                <strong class="badge-motto">{c.tagMotto}</strong>
                <span class="badge-sub">{c.tagSub}</span>
              </figcaption>
            </figure>
          </div>
        </div>

        <!-- STATS BAR -->
        <div class="stats-bar">
          {c.stats.map((s) => (
            <div class="stat-item">
              <b class="stat-number">{s.val}</b>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TENTANG / ABOUT SECTION -->
    <section id="tentang" class="section section-about">
      <div class="wrap">
        <div class="split-layout">
          <div class="split-head">
            <span class="eyebrow">{c.aboutEb}</span>
            <h2 class="section-title">{c.aboutH2}</h2>
          </div>
          <div class="split-body story-body">
            <p class="story-lead">{c.p1}</p>
            <p>{c.p2}</p>
            <p>{c.p3}</p>
            <p>{c.p4}</p>
            <div class="motto-callout">
              <span class="motto-mark">“</span>
              <p class="motto-text">{c.motto}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PERJALANAN / JOURNEY TIMELINE -->
    <section id="perjalanan" class="section section-timeline">
      <div class="wrap">
        <div class="timeline-header">
          <span class="eyebrow">{c.jEb}</span>
          <h2 class="section-title">{c.jH2}</h2>
        </div>

        <ol class="timeline-list">
          {c.timeline.map((item) => (
            <li class={`timeline-item ${item.isNow ? 'is-now' : ''}`}>
              <div class="timeline-year-col">
                <span class="timeline-year">{item.year}</span>
              </div>
              <div class="timeline-marker"></div>
              <div class="timeline-content-card">
                <h3 class="timeline-title">
                  {item.title}
                  {item.pill && <span class="pill-badge">{item.pill}</span>}
                  {item.isNow && <span class="pill-now">Active</span>}
                </h3>
                <p class="timeline-desc">{item.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- EKOSISTEM CARDI -->
    <section id="ekosistem" class="section section-ecosystem">
      <div class="wrap">
        <div class="eco-header">
          <span class="eyebrow">{c.eEb}</span>
          <h2 class="section-title">{c.eH2}</h2>
        </div>

        <div class="eco-grid">
          {c.ecosystem.map((card) => (
            <a href={card.linkHref} class="eco-card" target="_blank" rel="noopener">
              <span class="eco-number">{card.num}</span>
              <h3 class="eco-title">{card.title}</h3>
              <p class="eco-desc">{card.desc}</p>
              <span class="eco-link">{card.linkText}</span>
            </a>
          ))}
        </div>

        <div class="brands-section">
          <span class="eyebrow brands-eyebrow">{c.brandsTitle}</span>
          <div class="brands-chips">
            {c.brands.map((brand) => (
              <span class="brand-chip">{brand}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- PUBLIKASI / TALKS & MEDIA -->
    <section id="publikasi" class="section section-publications">
      <div class="wrap">
        <div class="pub-header">
          <span class="eyebrow">{c.pubEb}</span>
          <h2 class="section-title">{c.pubH2}</h2>
        </div>

        <div class="pub-columns">
          <!-- Talks Column -->
          <div class="pub-col">
            <h3 class="pub-col-title">{c.talksTitle}</h3>
            <ul class="pub-list">
              {talks.map((t) => (
                <li class="pub-item">
                  <a href={t.href} target="_blank" rel="noopener" class="pub-link">
                    <div class="pub-info">
                      <span class="pub-source">{t.source}</span>
                      <span class="pub-name">{t.title}</span>
                    </div>
                    <span class="pub-arr">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Media Coverage Column -->
          <div class="pub-col">
            <h3 class="pub-col-title">{c.mediaTitle}</h3>
            <ul class="pub-list">
              {mediaFeatured.map((m) => (
                <li class="pub-item">
                  <a href={m.href} target="_blank" rel="noopener" class="pub-link">
                    <div class="pub-info">
                      <span class="pub-source">{m.source}</span>
                      <span class="pub-name">{m.title}</span>
                    </div>
                    <span class="pub-arr">↗</span>
                  </a>
                </li>
              ))}
            </ul>

            <!-- Collapsible older items -->
            <details class="pub-details">
              <summary class="pub-summary">
                <span class="more-label">{c.seeAllMedia}</span>
                <span class="less-label">{c.closeMedia}</span>
              </summary>
              <ul class="pub-list pub-list-nested">
                {mediaMore.map((m) => (
                  <li class="pub-item">
                    <a href={m.href} target="_blank" rel="noopener" class="pub-link">
                      <div class="pub-info">
                        <span class="pub-source">{m.source}</span>
                        <span class="pub-name">{m.title}</span>
                      </div>
                      <span class="pub-arr">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- KONTAK & NETWORK -->
    <section id="kontak" class="section section-contact">
      <div class="wrap">
        <div class="contact-card">
          <div class="contact-main">
            <h2 class="contact-title">{c.ctH2}</h2>
            <p class="contact-lead">{c.ctP}</p>
            <div class="contact-actions">
              <a class="btn btn-primary-light" href={waUrl} target="_blank" rel="noopener">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3Z"/>
                </svg>
                <span>{c.ctBtn}</span>
              </a>
              <a class="btn btn-ghost-light" href="https://deo.cardinusantara.com/" target="_blank" rel="noopener">
                deo.cardinusantara.com
              </a>
            </div>
            <p class="bni-badge">
              <span class="bni-dot"></span>
              {c.bniNote}
            </p>
          </div>

          <div class="contact-social">
            <span class="social-title">Connect</span>
            <ul class="social-list">
              <li>
                <a href="https://www.linkedin.com/in/deocardi/" target="_blank" rel="noopener" class="social-link">
                  <span>LinkedIn</span>
                  <span class="arr">↗</span>
                </a>
              </li>
              <li>
                <a href="https://www.instagram.com/deo_cardi/" target="_blank" rel="noopener" class="social-link">
                  <span>Instagram</span>
                  <span class="arr">↗</span>
                </a>
              </li>
              <li>
                <a href="https://www.tiktok.com/@deo_cardi" target="_blank" rel="noopener" class="social-link">
                  <span>TikTok</span>
                  <span class="arr">↗</span>
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/deocardi" target="_blank" rel="noopener" class="social-link">
                  <span>YouTube</span>
                  <span class="arr">↗</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* PURE LIGHT THEME - Matching landing page design system */
  :root {
    --c-ink: #0A1633;
    --c-body: #3D4B6B;
    --c-muted: #6B7A9C;
    --c-paper: #FFFFFF;
    --c-soft: #F5F8FE;
    --c-soft-hover: #EBF1FD;
    --c-line: #E6ECF7;
    --c-blue: #0258a4;
    --c-blue-hover: #01417a;
    --c-blue-subtle: #E8F1FC;
  }

  .founder-page {
    background: var(--c-paper);
    color: var(--c-ink);
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  /* LANGUAGE SWITCHER */
  .lang-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .lang-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .lang-pills {
    display: inline-flex;
    background: var(--c-soft);
    border: 1px solid var(--c-line);
    border-radius: 999px;
    padding: 3px;
    gap: 2px;
  }
  .lang-chip {
    padding: 4px 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-muted);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .lang-chip:hover {
    color: var(--c-blue);
  }
  .lang-chip.active {
    background: var(--c-blue);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(2, 88, 164, 0.25);
  }

  /* HERO */
  .founder-hero {
    padding: 40px 0 60px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F5F8FE 100%);
    border-bottom: 1px solid var(--c-line);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .kicker {
    display: inline-block;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-blue);
    margin-bottom: 12px;
  }
  .founder-title {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--c-ink);
    margin: 0 0 20px;
  }
  .founder-title .highlight {
    color: var(--c-blue);
  }
  .lead {
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--c-body);
    max-width: 44ch;
    margin: 0 0 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* BUTTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    padding: 13px 26px;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }
  .btn-primary {
    background: var(--c-blue);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(2, 88, 164, 0.25);
  }
  .btn-primary:hover {
    background: var(--c-blue-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(2, 88, 164, 0.32);
    color: #ffffff;
  }
  .btn-secondary {
    background: #ffffff;
    color: var(--c-ink);
    border: 1px solid var(--c-line);
    box-shadow: 0 2px 6px rgba(10, 22, 51, 0.04);
  }
  .btn-secondary:hover {
    border-color: var(--c-blue);
    color: var(--c-blue);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(10, 22, 51, 0.08);
  }

  /* PHOTO CARD */
  .hero-photo-wrap {
    display: flex;
    justify-content: center;
  }
  .founder-photo-card {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 420/490;
    border-radius: 28px;
    overflow: hidden;
    background: #E8EEF8;
    box-shadow:
      0 20px 40px -15px rgba(2, 88, 164, 0.16),
      0 0 0 1px rgba(230, 236, 247, 0.9);
  }
  .founder-photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }
  .founder-photo-card:hover img {
    transform: scale(1.02);
  }

  .photo-badge {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    background: rgba(10, 22, 51, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    border-radius: 18px;
    padding: 14px 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .badge-motto {
    display: block;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #ffffff;
    margin-bottom: 2px;
  }
  .badge-sub {
    display: block;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.82);
    font-weight: 500;
    line-height: 1.4;
  }

  /* STATS BAR */
  .stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--c-line);
  }
  @media (max-width: 800px) {
    .stats-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stat-number {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 800;
    color: var(--c-blue);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-size: 14px;
    color: var(--c-body);
    font-weight: 600;
    line-height: 1.4;
  }

  /* SECTION COMMONS */
  .section {
    padding: clamp(60px, 8vw, 96px) 0;
  }
  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-blue);
    margin-bottom: 10px;
  }
  .section-title {
    font-size: clamp(32px, 4.4vw, 48px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--c-ink);
    margin: 0;
  }

  /* SPLIT LAYOUT (TENTANG) */
  .section-about {
    background: var(--c-paper);
  }
  .split-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  @media (max-width: 860px) {
    .split-layout {
      grid-template-columns: 1fr;
    }
  }
  .story-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .story-body p {
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.7;
    color: var(--c-body);
    margin: 0;
