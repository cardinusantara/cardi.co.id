    ],
    principlesTitle: '商业哲学',
    principlesP1: '品牌清晰度 — 远甚于单纯的产品堆砌 — 决定了哪家企业能够真正赢得客户信赖并稳步扩张。确立核心定位之后，系统化的获客转化流程必须日夜不息地运转。',
    principlesP2: '这套哲学铸就了 Cardi 的双核引擎：<strong>Cardi Nusantara</strong> 筑牢高端品牌护城河，<strong>Cardi Agent</strong> 借助前沿 AI 自动化驱动实效销售。',
    otherRolesTitle: '其他社会职务',
    otherRolesDesc: 'BNI Passion 资深品牌顾问。',
    ctaTitle: '邀请 Deo 进行主题演讲或商业咨询交流。',
    ctaDesc: '聚焦领域：品牌破局、市场拓展战略 (GTM)、以及印尼商业 AI 实战落地。',
    ctaBtn: '通过 WhatsApp 预约沟通'
  }
};

const c = copy[lang] || copy.id;
---

<Layout title={c.title} description={c.desc} lang={lang}>
  <Navbar lang={lang} />

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-split" style="display:grid; grid-template-columns:1.2fr 0.8fr; gap:40px; align-items:center;">
          <div class="hero-copy">
            <span class="eyebrow">{c.eyebrow}</span>
            <h1>{c.name}</h1>
            <p class="lead">{c.lead}</p>
            <div class="btns">
              <a class="btn btn-dark" href="https://wa.me/6281289895646?text=Halo%20Pak%20Deo%2C%20saya%20ingin%20berdiskusi." target="_blank" rel="noopener">{c.btnWa}</a>
              <a class="btn btn-light" href={translatePath('/ekosistem/')}>{c.btnEco}</a>
            </div>
          </div>
          <div class="hero-side" style="display:flex; justify-content:center;">
            <div style="width:100%; max-width:340px; aspect-ratio:4/5; border-radius:24px; background:linear-gradient(135deg, rgba(26,75,240,0.08), rgba(229,169,60,0.12)); border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:24px;">
              <div style="width:96px; height:96px; border-radius:50%; background:var(--blue); color:#fff; display:flex; align-items:center; justify-content:center; font-size:36px; font-weight:800; margin-bottom:16px;">
                D
              </div>
              <h3 style="font-size:20px; font-weight:700; color:var(--ink); margin:0;">{c.name}</h3>
              <p style="font-size:14px; color:var(--muted); margin:4px 0 0;">{c.founderRole}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Perjalanan / Timeline -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">{c.secTimelineEyebrow}</span>
          <h2>{c.secTimelineTitle}</h2>
        </div>
        <div class="split">
          <ol class="timeline">
            {c.timeline.map((item) => (
              <li>
                <b>{item.year}</b>
                <h3>{item.role}</h3>
                <p>{item.place}</p>
              </li>
            ))}
          </ol>

          <div class="prose">
            <h3 style="font-size:24px; color:var(--ink); margin-bottom:12px;">{c.principlesTitle}</h3>
            <p set:html={c.principlesP1}></p>
            <p set:html={c.principlesP2}></p>
            
            <h3 style="font-size:24px; color:var(--ink); margin:28px 0 12px;">{c.otherRolesTitle}</h3>
            <p>{c.otherRolesDesc}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Band -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <div class="cta-band">
          <div>
            <h2>{c.ctaTitle}</h2>
            <p>{c.ctaDesc}</p>
          </div>
          <div class="btns">
            <a class="btn btn-light" href="https://wa.me/6281289895646?text=Halo%20Pak%20Deo%2C%20saya%20ingin%20mengundang%20Anda%20sebagai%20pembicara." target="_blank" rel="noopener">{c.ctaBtn}</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
