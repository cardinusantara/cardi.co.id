    timeline: [
      { year: '2012', role: '助教 (Teaching Assistant)', place: 'BINUS 大学' },
      { year: '—', role: '系统分析师 (System Analyst)', place: 'PT Nusantara Compnet Integrator' },
      { year: '—', role: '联合创始人兼 CMO, Kotagrosir.com', place: '获得美元风投的 B2B 电商科技企业' },
      { year: '2016', role: '创立 Foodinhands', place: '知名美食垂直媒体与社群平台' },
      { year: '2017', role: '创立 Inhands Agency', place: 'PT Inhands Solusi Digital — 餐饮与品牌全案咨询' },
      { year: '—', role: '市场营销副总裁 (VP Marketing), Nikmat Group', place: '操盘旗下 Kopi Lain Hati, Street Boba, Gildak 等国民茶饮连锁' },
