---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
