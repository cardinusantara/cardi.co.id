    secTimelineTitle: 'From enterprise IT, startups, F&B, to applied AI.',
    timeline: [
      { year: '2012', role: 'Teaching Assistant', place: 'BINUS University.' },
      { year: '—', role: 'System Analyst', place: 'PT Nusantara Compnet Integrator.' },
      { year: '—', role: 'Co-Founder & CMO, Kotagrosir.com', place: 'Venture-backed B2B tech startup.' },
      { year: '2016', role: 'Founder, Foodinhands', place: 'Culinary community and media platform.' },
      { year: '2017', role: 'Founder, Inhands Agency', place: 'PT Inhands Solusi Digital — specialized F&B & brand consultancy.' },
      { year: '—', role: 'VP Marketing, Nikmat Group', place: 'Kopi Lain Hati, Street Boba, Gildak.' },
