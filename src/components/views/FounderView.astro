    desc: 'Profile of Deo Cardi Nathanael, Founder & Creative Director of Cardi.',
    eyebrow: 'Founder',
    name: 'Deo Cardi Nathanael',
    lead: 'Founder & Creative Director of Cardi. A decade of architecting brands and digital marketing systems for Indonesian enterprise.',
    btnWa: 'Reach out via WhatsApp',
