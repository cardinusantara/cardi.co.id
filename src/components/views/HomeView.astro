---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import HeroStory from '../HeroStory.astro';
import Journey from '../Journey.astro';
import ScrollFlowSection from '../ScrollFlowSection.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={t('seo.homeTitle')} description={t('seo.homeDesc')} lang={lang} hasIntro={true}>
  <!-- NAV -->
  <Navbar lang={lang} />

  <!-- HERO -->
  <div class="hero">
    <HeroStory lang={lang} />
  </div>

  <!-- PERJALANAN PELANGGAN (JOURNEY) -->
  <section class="sec sec-tight">
    <div class="wrap">
      <Journey lang={lang} />
    </div>
  </section>

  <!-- DUA PINTU -->
  <section class="sec" id="pintu">
    <div class="wrap">
      <div class="sec-head">
        <h2>{t('doors.title')}</h2>
      </div>
      <div class="grid g2">
        <!-- Pintu 1: Cardi Nusantara -->
        <article class="door door-nus">
          <div class="meta">
            <span class="k">{t('doors.nusBadge')}</span>
            <span>{t('doors.nusDomain')}</span>
          </div>
          <h3>Cardi Nusantara</h3>
          <p class="quote">{t('doors.nusQuote')}</p>
          <p>{t('doors.nusDesc')}</p>
          <div class="mini g2 grid">
            <div class="mini-item"><b>{t('doors.nusItem1Title')}</b>{t('doors.nusItem1Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem2Title')}</b>{t('doors.nusItem2Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem3Title')}</b>{t('doors.nusItem3Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem4Title')}</b>{t('doors.nusItem4Desc')}</div>
          </div>
          <a class="btn btn-nus" href="https://cardinusantara.com/" target="_blank" rel="noopener noreferrer">{t('doors.nusBtn')}</a>
        </article>

        <!-- Pintu 2: Cardi Agent -->
        <article class="door door-agent">
          <div class="meta">
            <span class="k">{t('doors.agentBadge')}</span>
            <span>{t('doors.agentDomain')}</span>
          </div>
          <h3>Cardi Agent</h3>
          <p class="quote">{t('doors.agentQuote')}</p>
          <p>{t('doors.agentDesc')}</p>
          <div class="mini">
            <div class="mini-item"><b>{t('doors.agentItem1Title')}</b>{t('doors.agentItem1Desc')}</div>
            <div class="mini-item"><b>{t('doors.agentItem2Title')}</b>{t('doors.agentItem2Desc')}</div>
            <div class="mini-item"><b>{t('doors.agentItem3Title')}</b>{t('doors.agentItem3Desc')}</div>
          </div>
          <a class="btn btn-agent" href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener noreferrer">{t('doors.agentBtn')}</a>
        </article>
      </div>

      <!-- Strip -->
      <div class="strip" style="border-radius:20px;margin-top:24px;padding:24px 28px">
        <div class="strip-in">
          <p>{t('doors.stripText')}</p>
          <a class="btn btn-dark" href={translatePath('/cek-brand/')}>{t('doors.stripBtn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SALING MENGUATKAN -->
  <section class="sec sec-white">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{t('synergy.tag')}</span>
        <h2>{t('synergy.title')}</h2>
      </div>
      <div class="grid g3">
        <article class="card">
          <div class="card-top"><span class="num">01</span></div>
          <h3>{t('synergy.c1Title')}</h3>
          <p>{t('synergy.c1Desc')}</p>
        </article>
        <article class="card">
          <div class="card-top"><span class="num">02</span></div>
          <h3>{t('synergy.c2Title')}</h3>
          <p>{t('synergy.c2Desc')}</p>
        </article>
        <article class="card">
          <div class="card-top"><span class="num">03</span></div>
          <h3>{t('synergy.c3Title')}</h3>
          <p>{t('synergy.c3Desc')}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FOUNDER PROFILE -->
  <section class="sec">
    <div class="wrap">
      <div class="split" style="align-items:center; gap: 48px;">
        <div class="founder-photo-wrap" style="position:relative; max-width:380px; width:100%; border-radius:20px; overflow:hidden; box-shadow:0 20px 40px -15px rgba(10,22,51,0.12); border:1px solid var(--line);">
          <img
            src="/deo-cardi.jpg"
            alt="Deo Cardi Nathanael - Founder Cardi"
            width="380"
            height="460"
            style="width:100%; height:auto; display:block; object-fit:cover;"
            loading="lazy"
          />
        </div>
        <div class="prose">
          <span class="eyebrow">{t('founder.tag')}</span>
          <h2 style="font-size:clamp(28px, 3.5vw, 36px); color:var(--ink); margin: 8px 0 16px;">{t('founder.name')}</h2>
          <p style="font-size: 16px; line-height: 1.6; color: var(--body); margin-bottom: 16px;">{t('founder.bio')}</p>
          <p style="font-size: 17px; line-height: 1.5; margin-bottom: 24px;"><strong style="color:var(--ink)">"{t('founder.quote')}"</strong></p>
          <a href={translatePath('/deo-cardi-nathanael-profile/')} class="btn ghost" style="display:inline-flex; align-items:center; gap:8px;">{t('founder.btn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUK (SCROLL FLOW - EKOSISTEM BISNIS TERPADU) -->
  <ScrollFlowSection lang={lang} />

  <!-- SOLUSI -->
  <section class="solusi" id="solusi">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('sol.tag')}</div>
        <h2 class="h2">{t('sol.title')}</h2>
        <p class="sub">{t('sol.sub')}</p>
      </div>
      <div class="solGrid">
        <div class="scard">
          <div class="ic" style="background:#E7EDFF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#1e4fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6" />
            </svg></div>
          <h3>{t('sol.c1Title')}</h3>
          <p>{t('sol.c1Desc')}</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#E3F6EF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#00A87E" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 17l6-6 4 4 8-8M21 7v6h-6" />
            </svg></div>
          <h3>{t('sol.c2Title')}</h3>
          <p>{t('sol.c2Desc')}</p>
        </div>
        <div class="scard">
          <div class="ic" style="background:#F1E7FF"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="#8B3DFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" />
              <rect x="3" y="14" width="7" height="7" rx="1.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" />
            </svg></div>
          <h3>{t('sol.c3Title')}</h3>
          <p>{t('sol.c3Desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="wrap statGrid">
      <div class="stat"><b>10<em>+</em></b><span>tahun pengalaman branding &amp; digital</span></div>
      <div class="stat"><b>19<em>+</em></b><span>klien aktif lintas industri</span></div>
      <div class="stat"><b>37</b><span>talenta dalam satu tim eksekusi</span></div>
      <div class="stat"><b>24<em>/7</em></b><span>AI bekerja tanpa henti</span></div>
    </div>
  </section>

  <!-- HARGA -->
  <section id="harga" class="sec" style="background: var(--soft);">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('pri.tag')}</div>
        <h2 class="h2">{t('pri.title')}</h2>
        <p class="sub">{t('pri.sub')}</p>
      </div>

      <div class="grid g4" style="margin-top: 40px;">
        <!-- Cardi Branding -->
        <article class="pcard" style="border-color: #FCD6D3; box-shadow: 0 12px 30px -10px rgba(255,59,48,.08);">
          <div class="lock">
            <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#fb3202"
                transform="translate(60 60) rotate(0) scale(1.3) translate(-60 -38)" />
            </svg>
            <div class="tx"><small>cardi</small><b>branding</b></div>
          </div>
          <h3 style="margin-top: 10px;">Cardi Branding</h3>
          <p>{t('eco.s1Desc')}</p>
          <div style="margin: 18px 0 8px;">
            <small style="display:block; font-size:11.5px; font-weight:700; color:var(--muted); letter-spacing:.06em;">{t('pri.modelLabel')} · {t('eco.s1Model')}</small>
            <span style="font-size:26px; font-weight:800; color:var(--ink); letter-spacing:-.02em;">{t('eco.s1Hook')}</span>
          </div>
          <a class="btn" href="https://branding.cardinusantara.com/" target="_blank" rel="noopener noreferrer" style="justify-content:center; background:#fb3202">{t('pri.brandingBtn')}</a>
        </article>

        <!-- Cardi Nusantara -->
        <article class="pcard" style="border-color: #D0D4DC; box-shadow: 0 12px 30px -10px rgba(10,22,51,.08);">
          <div class="lock">
            <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#0A1633"
                transform="translate(60 60) rotate(0) scale(1.3) translate(-60 -38)" />
            </svg>
            <div class="tx"><small>cardi</small><b>nusantara</b></div>
          </div>
          <h3 style="margin-top: 10px;">Cardi Nusantara</h3>
          <p>{t('eco.s2Desc')}</p>
          <div style="margin: 18px 0 8px;">
            <small style="display:block; font-size:11.5px; font-weight:700; color:var(--muted); letter-spacing:.06em;">{t('pri.modelLabel')} · {t('eco.s2Model')}</small>
            <span style="font-size:26px; font-weight:800; color:var(--ink); letter-spacing:-.02em;">{t('eco.s2Hook')}</span>
          </div>
          <a class="btn" href="https://cardinusantara.com/" target="_blank" rel="noopener noreferrer" style="justify-content:center; background:#0A1633">{t('pri.gtmBtn')}</a>
        </article>

        <!-- Cardi Digital -->
        <article class="pcard" style="border-color: #F8D3D0; box-shadow: 0 12px 30px -10px rgba(198,26,9,.08);">
          <div class="lock">
            <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#c42025"
                transform="translate(60 52) rotate(0) scale(1.3) translate(-60 -38)" />
              <circle cx="60" cy="102" r="8" fill="#c42025" />
            </svg>
            <div class="tx"><small>cardi</small><b>digital</b></div>
          </div>
          <h3 style="margin-top: 10px;">Cardi Digital</h3>
          <p>{t('eco.s3Desc')}</p>
          <div style="margin: 18px 0 8px;">
            <small style="display:block; font-size:11.5px; font-weight:700; color:var(--muted); letter-spacing:.06em;">{t('pri.modelLabel')} · {t('eco.s3Model')}</small>
            <span style="font-size:26px; font-weight:800; color:var(--ink); letter-spacing:-.02em;">{t('eco.s3Hook')}</span>
          </div>
          <a class="btn" href="https://digital.cardinusantara.com/" target="_blank" rel="noopener noreferrer" style="justify-content:center; background:#c42025">{t('pri.digitalBtn')}</a>
        </article>

        <!-- Cardi Agent -->
        <article class="pcard" style="border-color: #1e4fff; box-shadow: 0 12px 30px -10px rgba(30,79,255,.15);">
          <div class="lock">
            <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#1e4fff"
                transform="translate(66 60) rotate(90) scale(1.3) translate(-60 -38)" />
              <circle cx="26" cy="60" r="8" fill="#1e4fff" />
            </svg>
            <div class="tx"><small>cardi</small><b>agent</b></div>
          </div>
          <h3 style="margin-top: 10px;">Cardi Agent</h3>
          <p>{t('eco.s4Desc')}</p>
          <div style="margin: 18px 0 8px;">
            <small style="display:block; font-size:11.5px; font-weight:700; color:var(--muted); letter-spacing:.06em;">{t('pri.modelLabel')} · {t('eco.s4Model')}</small>
            <span style="font-size:26px; font-weight:800; color:var(--ink); letter-spacing:-.02em;">{t('eco.s4Hook')}</span>
          </div>
          <a class="btn" href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener noreferrer" style="justify-content:center; background:#1e4fff">{t('pri.ipoBtn')}</a>
        </article>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL MARQUEE -->
  <section class="testi" id="testimoni">
    <div class="wrap">
      <div class="center">
        <div class="eyebrow">{t('test.tag')}</div>
        <h2 class="h2">{t('test.title')}</h2>
        <p class="sub">{t('test.sub')}</p>
      </div>
    </div>

    <div class="testi-marquee" aria-label="Testimonials">
      <div class="testi-track">
        <!-- SET 1 -->
        <article class="testi-card">
          <div class="testi-product" style="color:#fb3202">{t('test.t1Product')}</div>
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>{t('test.t1Quote')}</blockquote>
          <div class="testi-who">{t('test.t1Who')}</div>
        </article>
        <article class="testi-card">
          <div class="testi-product" style="color:#0A1633">{t('test.t2Product')}</div>
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>{t('test.t2Quote')}</blockquote>
          <div class="testi-who">{t('test.t2Who')}</div>
        </article>
        <article class="testi-card">
          <div class="testi-product" style="color:#c42025">{t('test.t3Product')}</div>
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>{t('test.t3Quote')}</blockquote>
          <div class="testi-who">{t('test.t3Who')}</div>
        </article>
        <article class="testi-card">
          <div class="testi-product" style="color:#1e4fff">{t('test.t4Product')}</div>
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>{t('test.t4Quote')}</blockquote>
          <div class="testi-who">{t('test.t4Who')}</div>
        </article>

        <!-- SET 2 (duplicate for seamless loop) -->
        <article class="testi-card" aria-hidden="true">
          <div class="testi-product" style="color:#fb3202">{t('test.t1Product')}</div>
          <div class="stars">★★★★★</div>
          <blockquote>{t('test.t1Quote')}</blockquote>
          <div class="testi-who">{t('test.t1Who')}</div>
        </article>
        <article class="testi-card" aria-hidden="true">
          <div class="testi-product" style="color:#0A1633">{t('test.t2Product')}</div>
          <div class="stars">★★★★★</div>
          <blockquote>{t('test.t2Quote')}</blockquote>
          <div class="testi-who">{t('test.t2Who')}</div>
        </article>
        <article class="testi-card" aria-hidden="true">
          <div class="testi-product" style="color:#c42025">{t('test.t3Product')}</div>
          <div class="stars">★★★★★</div>
          <blockquote>{t('test.t3Quote')}</blockquote>
          <div class="testi-who">{t('test.t3Who')}</div>
        </article>
        <article class="testi-card" aria-hidden="true">
          <div class="testi-product" style="color:#1e4fff">{t('test.t4Product')}</div>
          <div class="stars">★★★★★</div>
          <blockquote>{t('test.t4Quote')}</blockquote>
          <div class="testi-who">{t('test.t4Who')}</div>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="sec">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>{t('cta.newTitle')}</h2>
          <p>{t('cta.newDesc')}</p>
        </div>
        <div class="btns">
          <a class="btn btn-light" href="https://wa.me/6281289895646?text=Halo%20Cardi%2C%20saya%20ingin%20konsultasi%20soal%20bisnis%20saya." target="_blank" rel="noopener noreferrer">{t('cta.newBtn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <Footer lang={lang} />
</Layout>
