---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import HeroStory from '../HeroStory.astro';
import Journey from '../Journey.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={t('seo.homeTitle')} description={t('seo.homeDesc')} lang={lang} hasIntro={true}>
  <!-- NAV -->
  <Navbar lang={lang} />

  <!-- HERO -->
  <div class="hero">
    <HeroStory lang={lang} />
  </div>

  <!-- PERJALANAN PELANGGAN (JOURNEY) -->
  <section class="sec sec-tight">
    <div class="wrap">
      <Journey lang={lang} />
    </div>
  </section>

  <!-- DUA PINTU -->
  <section class="sec" id="pintu">
    <div class="wrap">
      <div class="sec-head">
        <h2>{t('doors.title')}</h2>
      </div>
      <div class="grid g2">
        <!-- Pintu 1: Cardi Nusantara -->
        <article class="door door-nus">
          <div class="meta">
            <span class="k">{t('doors.nusBadge')}</span>
            <span>{t('doors.nusDomain')}</span>
          </div>
          <h3>Cardi Nusantara</h3>
          <p class="quote">{t('doors.nusQuote')}</p>
          <p>{t('doors.nusDesc')}</p>
          <div class="mini g2 grid">
            <div class="mini-item"><b>{t('doors.nusItem1Title')}</b>{t('doors.nusItem1Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem2Title')}</b>{t('doors.nusItem2Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem3Title')}</b>{t('doors.nusItem3Desc')}</div>
            <div class="mini-item"><b>{t('doors.nusItem4Title')}</b>{t('doors.nusItem4Desc')}</div>
          </div>
          <a class="btn btn-nus" href="https://cardinusantara.com/" target="_blank" rel="noopener noreferrer">{t('doors.nusBtn')}</a>
        </article>

        <!-- Pintu 2: Cardi Agent -->
        <article class="door door-agent">
          <div class="meta">
            <span class="k">{t('doors.agentBadge')}</span>
            <span>{t('doors.agentDomain')}</span>
          </div>
          <h3>Cardi Agent</h3>
          <p class="quote">{t('doors.agentQuote')}</p>
          <p>{t('doors.agentDesc')}</p>
          <div class="mini">
            <div class="mini-item"><b>{t('doors.agentItem1Title')}</b>{t('doors.agentItem1Desc')}</div>
            <div class="mini-item"><b>{t('doors.agentItem2Title')}</b>{t('doors.agentItem2Desc')}</div>
            <div class="mini-item"><b>{t('doors.agentItem3Title')}</b>{t('doors.agentItem3Desc')}</div>
          </div>
          <a class="btn btn-agent" href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener noreferrer">{t('doors.agentBtn')}</a>
        </article>
      </div>

      <!-- Strip -->
      <div class="strip" style="border-radius:20px;margin-top:24px;padding:24px 28px">
        <div class="strip-in">
          <p>{t('doors.stripText')}</p>
          <a class="btn btn-dark" href={translatePath('/cek-brand/')}>{t('doors.stripBtn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SALING MENGUATKAN -->
  <section class="sec sec-white">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">{t('synergy.tag')}</span>
        <h2>{t('synergy.title')}</h2>
      </div>
      <div class="grid g3">
        <article class="card">
          <div class="card-top"><span class="num">01</span></div>
          <h3>{t('synergy.c1Title')}</h3>
          <p>{t('synergy.c1Desc')}</p>
        </article>
        <article class="card">
          <div class="card-top"><span class="num">02</span></div>
          <h3>{t('synergy.c2Title')}</h3>
          <p>{t('synergy.c2Desc')}</p>
        </article>
        <article class="card">
          <div class="card-top"><span class="num">03</span></div>
          <h3>{t('synergy.c3Title')}</h3>
          <p>{t('synergy.c3Desc')}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FOUNDER PROFILE -->
  <section class="sec">
    <div class="wrap">
      <div class="split" style="align-items:center; gap: 48px;">
        <div class="founder-photo-wrap" style="position:relative; max-width:380px; width:100%; border-radius:20px; overflow:hidden; box-shadow:0 20px 40px -15px rgba(10,22,51,0.12); border:1px solid var(--line);">
          <img
            src="/deo-cardi.jpg"
            alt="Deo Cardi Nathanael - Founder Cardi"
            width="380"
            height="460"
            style="width:100%; height:auto; display:block; object-fit:cover;"
            loading="lazy"
          />
        </div>
        <div class="prose">
          <span class="eyebrow">{t('founder.tag')}</span>
          <h2 style="font-size:clamp(28px, 3.5vw, 36px); color:var(--ink); margin: 8px 0 16px;">{t('founder.name')}</h2>
          <p style="font-size: 16px; line-height: 1.6; color: var(--body); margin-bottom: 16px;">{t('founder.bio')}</p>
          <p style="font-size: 17px; line-height: 1.5; margin-bottom: 24px;"><strong style="color:var(--ink)">"{t('founder.quote')}"</strong></p>
          <a href={translatePath('/deo-cardi-nathanael-profile/')} class="btn ghost" style="display:inline-flex; align-items:center; gap:8px;">{t('founder.btn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BAND -->
  <section class="sec">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2>{t('cta.newTitle')}</h2>
          <p>{t('cta.newDesc')}</p>
        </div>
        <div class="btns">
          <a class="btn btn-light" href="https://wa.me/6281289895646?text=Halo%20Cardi%2C%20saya%20ingin%20konsultasi%20soal%20bisnis%20saya." target="_blank" rel="noopener noreferrer">{t('cta.newBtn')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <Footer lang={lang} />
</Layout>
