        eshVt.textContent = item.title(brandName);
        eshVd.textContent = item.desc;
      }
    }

    const eshStatus = document.getElementById('esh-matrix-status');
    if (eshStatus) {
      if (L) {
        eshStatus.innerHTML = '<b>' + L.focus + '</b><br>' + t.roas + ': <b>' + (S.roas ? '✓' : '—') + '</b> · ' + t.grow + ': <b>' + (S.grow ? '✓' : '—') + '</b>';
      } else {
        eshStatus.innerHTML = '<em>' + t.selectRevenue + '</em>';
      }
    }

    const solTitleEl = document.getElementById('esh-sol-title');
    if (solTitleEl) solTitleEl.textContent = t.exportSolHeading;
    const c1 = document.getElementById('c1');
    const c2 = document.getElementById('c2');
    const c3 = document.getElementById('c3');
    const eshC1 = document.getElementById('esh-c1');
    const eshC2 = document.getElementById('esh-c2');
    const eshC3 = document.getElementById('esh-c3');
    if (c1 && eshC1) eshC1.innerHTML = c1.innerHTML;
    if (c2 && eshC2) eshC2.innerHTML = c2.innerHTML;
    if (c3 && eshC3) eshC3.innerHTML = c3.innerHTML;
  }

  function setExportingState(isExporting) {
    const t = I18N[currentLang];
    document.querySelectorAll('.btn-export').forEach(function(b) {
      b.disabled = isExporting;
    });
    if (isExporting) {
      document.querySelectorAll('.btn-export-jpg').forEach(function(b) { b.textContent = t.exporting; });
      document.querySelectorAll('.btn-export-pdf').forEach(function(b) { b.textContent = t.exporting; });
      document.querySelectorAll('.btn-share').forEach(function(b) { b.textContent = t.exporting; });
    } else {
      document.querySelectorAll('.btn-export-jpg').forEach(function(b) { b.textContent = t.btnJpg; });
      document.querySelectorAll('.btn-export-pdf').forEach(function(b) { b.textContent = t.btnPdf; });
      document.querySelectorAll('.btn-share').forEach(function(b) { b.textContent = t.btnShare; });
    }
  }

  async function prepareExportCanvas() {
    updateExportSummary();
    const wrapper = document.getElementById('export-sheet-wrapper');
    const sheet = document.getElementById('export-sheet');

    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready; } catch (e) {}
    }

    if (wrapper) wrapper.classList.add('is-rendering');
    await new Promise(function(r) { requestAnimationFrame(r); });
    await new Promise(function(r) { setTimeout(r, 60); });

    try {
      if (typeof html2canvas === 'undefined') throw new Error('html2canvas not loaded');
      const canvas = await html2canvas(sheet, {
        scale: 2,
        useCORS: true,
        allowTaint: true,
        backgroundColor: '#FFFFFF',
        logging: false,
        scrollX: 0,
        scrollY: 0,
        x: 0,
        y: 0,
        width: 960,
        windowWidth: 1024
      });
      return canvas;
    } finally {
      if (wrapper) wrapper.classList.remove('is-rendering');
    }
  }

  function getExportFileName() {
    const rawBrand = S.brand.trim() || 'Brand';
    const cleanBrand = rawBrand.replace(/[^a-zA-Z0-9_\u4e00-\u9fa5-]+/g, '-').replace(/^-+|-+$/g, '') || 'Brand';
    const now = new Date();
    const yyyy = now.getFullYear();
    const mm = String(now.getMonth() + 1).padStart(2, '0');
    const dd = String(now.getDate()).padStart(2, '0');
    return 'Brand-Check-' + cleanBrand + '-' + yyyy + '-' + mm + '-' + dd;
  }

  async function exportJPEG() {
    setExportingState(true);
    try {
      const canvas = await prepareExportCanvas();
      const fileName = getExportFileName() + '.jpg';
      canvas.toBlob(function(blob) {
        if (!blob) return;
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function() { URL.revokeObjectURL(url); }, 3000);
      }, 'image/jpeg', 0.95);
    } catch (err) {
      console.error('Export JPEG error:', err);
      alert('Gagal mengekspor JPEG. Silakan coba lagi.');
    } finally {
      setExportingState(false);
    }
  }

  async function exportPDF() {
    setExportingState(true);
    try {
      const canvas = await prepareExportCanvas();
      const fileName = getExportFileName() + '.pdf';
      const jsPDFClass = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
      if (!jsPDFClass) throw new Error('jsPDF library not loaded');

      const doc = new jsPDFClass({ orientation: 'portrait', unit: 'mm', format: 'a4' });
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();
      const margin = 10;
      const maxW = pageWidth - margin * 2;
      const maxH = pageHeight - margin * 2;
      const ratio = canvas.width / canvas.height;
      let renderW = maxW;
      let renderH = maxW / ratio;
      if (renderH > maxH) {
        renderH = maxH;
        renderW = maxH * ratio;
      }
      const x = (pageWidth - renderW) / 2;
      const y = (pageHeight - renderH) / 2;
      const imgData = canvas.toDataURL('image/jpeg', 0.95);
      doc.addImage(imgData, 'JPEG', x, y, renderW, renderH, undefined, 'FAST');
      doc.save(fileName);
    } catch (err) {
      console.error('Export PDF error:', err);
      alert('Gagal mengekspor PDF. Silakan coba lagi.');
    } finally {
      setExportingState(false);
    }
  }

  async function shareResult() {
    setExportingState(true);
    try {
      const canvas = await prepareExportCanvas();
      const fileName = getExportFileName() + '.jpg';
      const brandName = S.brand.trim() || I18N[currentLang].defaultBrandName;
      canvas.toBlob(async function(blob) {
        if (!blob) return;
        const file = new File([blob], fileName, { type: 'image/jpeg' });
        const shareData = {
          title: 'Brand Check · ' + brandName,
          text: 'Hasil Brand Check untuk ' + brandName + ' oleh Cardi Nusantara.'
        };
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          try {
            await navigator.share({ ...shareData, files: [file] });
          } catch (err) {
            if (err.name !== 'AbortError') console.warn('Share file error:', err);
          }
        } else if (navigator.share) {
          try {
            await navigator.share({ ...shareData, url: window.location.href });
          } catch (err) {
            if (err.name !== 'AbortError') console.warn('Share link error:', err);
          }
        }
      }, 'image/jpeg', 0.95);
    } catch (err) {
      console.error('Share error:', err);
      alert('Gagal membagikan hasil. Silakan coba lagi.');
    } finally {
      setExportingState(false);
    }
  }

