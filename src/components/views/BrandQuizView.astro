  try {
    const saved = localStorage.getItem(LANG_KEY);
    if (saved && ['id', 'en', 'zh'].includes(saved)) currentLang = saved;
  } catch (e) {}

  function getLevel(n, lang) {
    if (!n) return null;
    const l = lang || currentLang;
    const item = LEVELS_DATA[n - 1];
    const loc = item[l] || item.id;
    return {
      n: item.n,
      min: item.min,
      max: item.max,
      t: loc.t,
      o: loc.o,
      focus: loc.focus
    };
  }

  function getPillars(lang) {
    const l = lang || currentLang;
    return PILLARS_DATA.map(function(p) {
      const loc = p[l] || p.id;
      return {
        color: p.color,
        name: loc.name,
        q: loc.q,
        items: loc.items,
        svc: loc.svc,
        svcd: loc.svcd
      };
    });
  }

