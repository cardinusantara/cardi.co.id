  function switchLang(lang) {
    if (!['id', 'en', 'zh'].includes(lang)) return;
    currentLang = lang;
    try { localStorage.setItem(LANG_KEY, lang); } catch (e) {}
    applyStaticTranslations();
    buildStairs();
    buildPillars();
    render();
  }

  // Setup event listeners on DOM load
  document.addEventListener('DOMContentLoaded', function() {
    const langSelect = document.getElementById('lang-select');
    if (langSelect) {
      langSelect.value = currentLang;
      langSelect.addEventListener('change', function(e) {
        switchLang(e.target.value);
      });
    }

    const brandInput = document.getElementById('brand');
    if (brandInput) {
      brandInput.value = S.brand;
      brandInput.addEventListener('input', function() {
        S.brand = brandInput.value;
        saveState();
        render();
      });
    }

    ['roas', 'grow'].forEach(function(k) {
      const btn = document.getElementById(k);
      if (btn) {
        btn.addEventListener('click', function() {
          S[k] = !S[k];
          saveState();
          render();
        });
      }
    });

    const resetBtn = document.getElementById('btn-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        S = blankState();
        saveState();
        if (brandInput) {
          brandInput.value = '';
          brandInput.focus();
        }
        buildStairs();
        buildPillars();
        render();
      });
    }

    const fsBtn = document.getElementById('btn-fs');
    if (fsBtn) {
      fsBtn.addEventListener('click', function() {
        try {
          if (!document.fullscreenElement) document.documentElement.requestFullscreen();
          else document.exitFullscreen();
        } catch (e) {}
      });
    }

    document.querySelectorAll('.btn-export-jpg').forEach(function(b) { b.addEventListener('click', exportJPEG); });
    document.querySelectorAll('.btn-export-pdf').forEach(function(b) { b.addEventListener('click', exportPDF); });
    document.querySelectorAll('.btn-share').forEach(function(b) { b.addEventListener('click', shareResult); });

    applyStaticTranslations();
    buildStairs();
    buildPillars();
    render();
  });
</script>
