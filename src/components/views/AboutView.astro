const c = content[currentLang];
---

<Layout title={c.metaTitle} description={c.metaDesc} lang={lang}>
  <Navbar lang={lang} />

  <main id="main" class="about-page">
    <!-- ============ HERO ============ -->
    <section id="top" class="hero-section">
      <div class="wrap-narrow">
        <p class="section-eyebrow">{c.heroEyebrow}</p>
        <h1 class="hero-title">{c.heroH1}</h1>
        <p class="hero-lead">{c.heroLead}</p>
      </div>
    </section>

    <!-- ============ PERJALANAN ============ -->
    <section id="perjalanan" class="journey-section">
      <div class="wrap-standard">
        <p class="section-eyebrow">{c.journeyEyebrow}</p>
        <h2 class="section-title">{c.journeyH2}</h2>
        <div class="journey-split">
          <div class="journey-prose">
            <p class="body-p">{c.journeyP1}</p>
            <p class="body-p" set:html={c.journeyP2} />
          </div>
          <div class="journey-timeline">
            {c.timeline.map((item) => (
              <div class="timeline-entry">
                <span class="timeline-dot" aria-hidden="true" />
                <p class="timeline-year">{item.year}</p>
                <h3 class="timeline-heading">{item.title}</h3>
                <p class="timeline-text">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ FILOSOFI LOGO ============ -->
    <section id="filosofi" class="philosophy-section">
      <div class="wrap-standard philosophy-grid">
        <div class="philosophy-copy">
          <p class="section-eyebrow">{c.philosophyEyebrow}</p>
          <h2 class="section-title">{c.philosophyH2}</h2>
          <p class="body-p">{c.philosophyP1}</p>
          <p class="body-p">{c.philosophyP2}</p>
        </div>
        <div class="philosophy-visual">
          <svg viewBox="0 0 400 400" role="img" aria-label="Logo bunga delapan kelopak Cardi" class="flower-svg">
            <g>
              <path transform="rotate(0 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" />
              <path transform="rotate(45 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.92" />
              <path transform="rotate(90 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.84" />
              <path transform="rotate(135 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.92" />
              <path transform="rotate(180 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" />
              <path transform="rotate(225 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.92" />
              <path transform="rotate(270 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.84" />
              <path transform="rotate(315 200 200)" d="M200,200 C166,164 166,108 200,72  C234,108 234,164 200,200 Z" fill="#1f4f99" fill-opacity="0.92" />
            </g>
          </svg>
        </div>
      </div>
      <div class="wrap-standard philosophy-ribbon">
        <p class="tagline-text">{c.tagline}</p>
      </div>
    </section>

    <!-- ============ VISI & MISI ============ -->
    <section id="visi-misi" class="vision-mission-section">
      <div class="wrap-standard">
        <div class="vision-box">
          <p class="section-eyebrow text-center">{c.visionEyebrow}</p>
          <p class="vision-quote">{c.visionText}</p>
        </div>

        <p class="section-eyebrow text-center mission-tag">{c.missionEyebrow}</p>
        <div class="mission-grid">
          {c.missions.map((m) => (
            <article class="mission-card">
              <span class="mission-num">{m.num}</span>
              <h3 class="mission-title">{m.title}</h3>
              <p class="mission-desc">{m.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ VALUE CARDI ============ -->
    <section id="value" class="value-section">
      <div class="wrap-standard">
        <div class="value-head">
          <p class="section-eyebrow">{c.valueEyebrow}</p>
          <h2 class="value-h2">{c.valueH2}</h2>
          <p class="value-lead">{c.valueLead}</p>
        </div>
        <div class="value-grid">
          {c.values.map((v) => (
            <article class="value-card">
              <div class="value-badge">
                <span>{v.letter}</span>
              </div>
              <h3 class="value-title">{v.title}</h3>
              <p class="value-tag">{v.tag}</p>
              <p class="value-desc">{v.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta-section">
      <div class="wrap-narrow text-center">
        <h2 class="cta-title">{c.ctaH2}</h2>
        <p class="cta-lead">{c.ctaLead}</p>
        <a href={c.ctaLink} target="_blank" rel="noopener" class="cta-btn">
          {c.ctaBtn}
        </a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  /* Layout Wrappers */
  .about-page {
    background-color: #ffffff;
    color: #0f1a30;
    overflow-x: hidden;
  }

  .wrap-narrow {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .wrap-standard {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .text-center {
    text-align: center;
  }

  .highlight-bold {
    color: #0b1220;
    font-weight: 700;
  }

  /* Eyebrows */
  .section-eyebrow {
    font-size: 12.5px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: #1f4f99;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  /* Section Titles */
  .section-title {
    font-size: clamp(28px, 3.8vw, 44px);
    line-height: 1.12;
    font-weight: 800;
    color: #0b1220;
    margin-bottom: 36px;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .body-p {
    font-size: 16.5px;
    line-height: 1.85;
    color: #3a4560;
    margin-bottom: 20px;
    text-wrap: pretty;
  }

  /* Hero */
  .hero-section {
    padding: clamp(64px, 9vw, 112px) 0 clamp(48px, 7vw, 88px);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(34px, 5.6vw, 60px);
    line-height: 1.08;
    font-weight: 800;
    color: #0b1220;
    margin-bottom: 28px;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-lead {
    font-size: clamp(16px, 1.7vw, 18.5px);
    line-height: 1.75;
    color: #3a4560;
    max-width: 680px;
    margin: 0 auto;
    text-wrap: pretty;
  }

  /* Perjalanan / Journey */
  .journey-section {
    padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 7vw, 96px);
  }

  .journey-split {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 64px;
