---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const timeline = [
  { year: '2016', name: 'Foodinhands', desc: 'Media dan komunitas kuliner — belajar langsung bagaimana brand F&B dilihat dan diingat.' },
  { year: '2017', name: 'Inhands Agency', desc: 'Konsultan F&B dan branding untuk bisnis yang ingin naik kelas.' },
  { year: '—', name: 'Nikmat Group', desc: 'Memimpin marketing untuk Kopi Lain Hati, Street Boba, dan Gildak sebagai VP Marketing.' },
  { year: '2023', name: 'Cardi Nusantara', desc: 'Membangun grup jasa branding, digital, go-to-market, dan IPO Partner.' },
  { year: '2026', name: 'Ekosistem Cardi', desc: 'Cardi menjadi induk dari dua mesin: Cardi Nusantara (tim ahli) dan Cardi Agent (tim AI).' }
];

const pillars = [
  { num: '01', title: 'Dilihat', desc: 'Brand hadir di tempat pelanggan mencari.' },
  { num: '02', title: 'Diingat', desc: 'Identitas dan pesan yang konsisten.' },
  { num: '03', title: 'Dipercaya', desc: 'Reputasi yang dibangun dengan bukti.' },
  { num: '04', title: 'Dibeli', desc: 'Sistem penjualan yang berjalan setiap hari.' }
];
---

<Layout title="Tentang Cardi — Dilihat, Diingat, Dipercaya, Dibeli" description="Cerita dan filosofi Cardi: dilihat, diingat, dipercaya — lalu dibeli." lang={lang}>
  <Navbar lang={lang} />

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <span class="eyebrow">Tentang Cardi</span>
          <h1>Brand yang jelas adalah awal semua pertumbuhan.</h1>
          <p class="lead">Cardi lahir dari satu keyakinan: yang menentukan bisnis dipercaya dan tumbuh bukan hanya kualitas produk, tapi kejelasan brand-nya — lalu sistem yang membuat penjualan terus berjalan.</p>
        </div>
      </div>
    </section>

    <!-- Perjalanan / Timeline -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Perjalanan</span>
          <h2>Dari komunitas kuliner sampai ekosistem AI.</h2>
        </div>
        <div class="split">
          <div class="prose">
            <p>Selama lebih dari satu dekade kami membantu bisnis Indonesia membangun brand. Polanya selalu sama: bisnis yang brand-nya jelas lebih mudah dipercaya — tapi banyak yang berhenti di situ karena penjualan, tagihan, dan pelanggan lama tidak terurus.</p>
            <p>Karena itu Cardi kini punya dua mesin. <strong>Cardi Nusantara</strong> membangun brand bersama tim ahli. <strong>Cardi Agent</strong> menjalankan sistem penjualan dengan AI.</p>
          </div>
          <ol class="timeline">
            {timeline.map((item) => (
              <li>
                <b>{item.year}</b>
                <h3>{item.name}</h3>
                <p>{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- 4 Pilar Filosofi -->
    <section class="sec sec-white">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Filosofi</span>
          <h2>Dilihat, diingat, dipercaya — lalu dibeli.</h2>
        </div>
        <div class="grid g4">
          {pillars.map((p) => (
            <article class="card">
              <div class="card-top">
                <span class="num">{p.num}</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Kepemimpinan -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">Kepemimpinan</span>
          <h2>Orang di balik Cardi.</h2>
        </div>
        <div class="grid g2">
          <article class="card">
            <div class="card-top"></div>
            <h3>Deo Cardi Nathanael</h3>
            <p>Founder &amp; CEO · Creative Director</p>
            <a class="card-link" href={translatePath('/deo-cardi-nathanael-profile')}>Profil →</a>
          </article>
          <article class="card">
            <div class="card-top"></div>
            <h3>Vanesha Octania</h3>
            <p>Creative Director &amp; Brand Strategist</p>
          </article>
        </div>
      </div>
    </section>

    <!-- CTA Band -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <div class="cta-band">
          <div>
            <h2>Mari bicara soal bisnismu.</h2>
            <p>Kami dengarkan dulu, lalu tunjukkan pintu yang tepat.</p>
          </div>
          <div class="btns">
            <a class="btn btn-light" href="https://wa.me/6281289895646?text=Halo%20Cardi%2C%20saya%20ingin%20kenal%20lebih%20jauh." target="_blank" rel="noopener">Konsultasi via WhatsApp</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>
