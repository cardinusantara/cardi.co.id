const c = content[currentLang];
---

<DeckViewer
  lang={lang}
  title={c.title}
  eyebrow={c.eyebrow}
  description={c.description}
  pdfUrl="/Cardi - Cara Bikin Brand.pdf"
  downloadFilename={c.downloadFilename}
  fileSize="5.2 MB"
  totalPages={54}
  updatedDate="2026"
  waMessage={c.waMessage}
  chapters={c.chapters}
  highlights={c.highlights}
  metaTitle={c.metaTitle}
  metaDesc={c.metaDesc}
/>
