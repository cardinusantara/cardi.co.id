---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

export interface Chapter {
  number: string;
  page: number;
  title: string;
  desc: string;
  badge?: string;
  icon?: string;
}

export interface Highlight {
  title: string;
  desc: string;
  tag: string;
  iconSvg?: string;
}

interface Props {
  lang?: LangKey;
  title: string;
  eyebrow?: string;
  description: string;
  pdfUrl: string;
  downloadFilename: string;
  fileSize: string;
  totalPages: number;
  updatedDate?: string;
  waMessage: string;
  chapters: Chapter[];
  highlights?: Highlight[];
  metaTitle: string;
  metaDesc: string;
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  eyebrow = "Dokumen Resmi PT Digital Cardi Nusantara",
  description,
  pdfUrl,
  downloadFilename,
  fileSize,
  totalPages,
  updatedDate = "2026",
  waMessage,
  chapters = [],
  highlights = [],
  metaTitle,
  metaDesc
} = Astro.props;

const currentLang = (lang as string) === 'en' ? 'en' : (lang as string) === 'zh' ? 'zh' : 'id';
const translatePath = useTranslatedPath(lang);

const uiText = {
  id: {
    badge: "DOKUMEN RESMI CARDI",
    formatBadge: "PRESENTATION DECK",
    pagesBadge: `${totalPages} Halaman`,
    sizeBadge: fileSize,
    verifiedBadge: "Terverifikasi",
    actionStart: "Mulai Membaca",
    actionDownload: `Unduh PDF (${fileSize})`,
    actionWa: "Konsultasi Penawaran",
    actionCopy: "Salin Link",
    copied: "Link tersalin!",
    fullscreen: "Layar Penuh",
    exitFullscreen: "Keluar Layar Penuh",
    print: "Cetak",
    firstPage: "Pertama",
    prevPage: "Sebelumnya",
    nextPage: "Berikutnya",
    lastPage: "Terakhir",
    page: "Halaman",
    of: "dari",
    jump: "Lompat",
    zoomIn: "Perbesar",
    zoomOut: "Perkecil",
    fitWidth: "Sesuaikan Lebar",
    thumbnails: "Daftar Slide",
    hideThumbnails: "Tutup Daftar",
    loading: "Memuat dokumen presentasi...",
    loadingDesc: "Menyiapkan slide berkualitas tinggi dengan teknologi Cardi View",
    fallbackNotice: "Mengalami kendala tampilan interaktif?",
    openNative: "Buka Tampilan Standar",
    tocEyebrow: "Navigasi Cepat Bab",
    tocTitle: "Daftar Isi & Lompat ke Bab Terpilih",
    tocDesc: "Klik salah satu kartu di bawah ini untuk langsung menuju halaman materi spesifik yang Anda butuhkan.",
    jumpToPage: "Buka Halaman",
    summaryEyebrow: "Ringkasan Materi",
    summaryTitle: "Poin Kunci & Nilai Strategis Dokumen",
    ctaEyebrow: "Langkah Selanjutnya",
    ctaTitle: "Diskusikan Kebutuhan Pertumbuhan Brand Anda",
    ctaDesc: "Tim ahli strategi dan ekosistem bisnis Cardi siap menganalisis portofolio, positioning, dan proyeksi aktivasi brand Anda.",
    ctaWaBtn: "Hubungi Kami via WhatsApp",
    ctaCheckBrandBtn: "Cek Brand Gratis",
    tipKeyboard: "Gunakan tombol panah ◀ / ▶ atau spasi pada keyboard untuk berpindah slide."
  },
  en: {
    badge: "CARDI OFFICIAL DOCUMENT",
    formatBadge: "PRESENTATION DECK",
    pagesBadge: `${totalPages} Pages`,
    sizeBadge: fileSize,
    verifiedBadge: "Verified",
    actionStart: "Start Reading",
    actionDownload: `Download PDF (${fileSize})`,
    actionWa: "Consult Offering",
    actionCopy: "Copy Link",
    copied: "Link copied!",
    fullscreen: "Fullscreen",
    exitFullscreen: "Exit Fullscreen",
    print: "Print",
    firstPage: "First",
    prevPage: "Previous",
    nextPage: "Next",
    lastPage: "Last",
    page: "Page",
    of: "of",
    jump: "Go",
    zoomIn: "Zoom In",
    zoomOut: "Zoom Out",
    fitWidth: "Fit Width",
    thumbnails: "Slide List",
    hideThumbnails: "Hide List",
    loading: "Loading presentation document...",
    loadingDesc: "Rendering high-fidelity slides powered by Cardi View",
    fallbackNotice: "Experiencing display issues?",
    openNative: "Open Standard View",
    tocEyebrow: "Quick Chapters",
    tocTitle: "Table of Contents & Jump to Sections",
    tocDesc: "Click any section below to immediately navigate the viewer to that specific topic.",
    jumpToPage: "Open Page",
    summaryEyebrow: "Executive Summary",
    summaryTitle: "Key Strategic Takeaways",
    ctaEyebrow: "Next Steps",
    ctaTitle: "Discuss Your Brand Acceleration with Us",
    ctaDesc: "Cardi's growth strategists and operations ecosystem are ready to analyze your portfolio and growth roadmap.",
    ctaWaBtn: "Contact Us via WhatsApp",
    ctaCheckBrandBtn: "Free Brand Diagnostic",
    tipKeyboard: "Use ◀ / ▶ arrow keys or spacebar on your keyboard to navigate slides."
  },
  zh: {
    badge: "CARDI 官方文件",
    formatBadge: "展示幻灯片",
    pagesBadge: `${totalPages} 页`,
    sizeBadge: fileSize,
    verifiedBadge: "已验证",
    actionStart: "开始阅读",
    actionDownload: `下载 PDF (${fileSize})`,
    actionWa: "咨询方案",
    actionCopy: "复制链接",
    copied: "链接已复制！",
    fullscreen: "全屏模式",
    exitFullscreen: "退出全屏",
    print: "打印",
    firstPage: "首页",
    prevPage: "上一页",
    nextPage: "下一页",
    lastPage: "末页",
    page: "第",
    of: "页，共",
    jump: "跳转",
    zoomIn: "放大",
    zoomOut: "缩小",
    fitWidth: "适应宽度",
    thumbnails: "幻灯片列表",
    hideThumbnails: "收起列表",
    loading: "正在加载展示文件...",
    loadingDesc: "通过 Cardi View 渲染高清晰度幻灯片",
    fallbackNotice: "交互式查看遇到问题？",
    openNative: "打开原生查看器",
    tocEyebrow: "章节速览",
    tocTitle: "目录与快速跳转",
    tocDesc: "点击下方任意卡片，阅读器将立即跳转至该主题页面。",
    jumpToPage: "打开第",
    summaryEyebrow: "执行摘要",
    summaryTitle: "核心战略要点",
    ctaEyebrow: "下一步",
    ctaTitle: "与我们探讨您的品牌增长方案",
    ctaDesc: "Cardi 增长专家与生态运营团队随时为您评估品牌定位与激活路径。",
    ctaWaBtn: "通过 WhatsApp 联系我们",
    ctaCheckBrandBtn: "免费品牌体检",
    tipKeyboard: "您也可以使用键盘上的 ◀ / ▶ 方向键或空格键翻页。"
  }
};

const t = uiText[currentLang];
const waUrl = `https://wa.me/6281289895646?text=${encodeURIComponent(waMessage)}`;
---

<Layout title={metaTitle} description={metaDesc} lang={lang}>
  <Navbar lang={lang} />

  <main id="main" class="deck-page">
    <!-- ============ HERO HEADER ============ -->
    <section class="deck-hero-section">
      <div class="wrap">
        <div class="deck-hero-card">
          <!-- Top Tag Bar -->
          <div class="deck-badge-group">
            <span class="deck-pill official">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              {t.badge}
            </span>
            <span class="deck-pill format">{t.formatBadge}</span>
            <span class="deck-pill meta">{t.pagesBadge}</span>
            <span class="deck-pill meta">{t.sizeBadge}</span>
            <span class="deck-pill date">Update {updatedDate}</span>
          </div>

          <!-- Title & Subtitle -->
          <h1 class="deck-title">{title}</h1>
          <p class="deck-description">{description}</p>

          <!-- Action Button Cluster -->
          <div class="deck-action-bar">
            <a href="#deck-viewer-anchor" class="btn deck-btn primary" id="btn-scroll-viewer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
              {t.actionStart}
            </a>

            <a href={pdfUrl} download={downloadFilename} class="btn deck-btn download" target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              {t.actionDownload}
            </a>

            <a href={waUrl} target="_blank" rel="noopener" class="btn deck-btn wa">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.4-.7-2.9-1.2-4.7-4.1-4.9-4.3-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c.1.2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.2 2.4 1.5 2.7 1.7.3.1.5.1.7-.1l1-1.2c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.4 0 .1 0 .7-.1 1.4Z" />
              </svg>
              {t.actionWa}
            </a>

            <button type="button" class="btn deck-btn ghost" id="btn-copy-link">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <span id="copy-text">{t.actionCopy}</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Anchor for smooth scrolling -->
    <div id="deck-viewer-anchor" style="position:relative; top:-90px;"></div>

    <!-- ============ PRESENTATION DECK VIEWER ============ -->
    <section class="deck-viewer-section" id="deck-viewer-section">
      <div class="wrap">
        <div class="deck-container" id="deck-container">
          <!-- Top Deck Chrome Toolbar -->
          <div class="deck-toolbar">
            <!-- Left: Document & Page Info -->
            <div class="toolbar-left">
              <span class="doc-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </span>
              <span class="doc-title-pill" title={downloadFilename}>{downloadFilename}</span>
              <div class="page-counter-badge">
                <span id="page-num">1</span> <span class="counter-slash">/</span> <span id="page-count">{totalPages}</span>
              </div>
            </div>

            <!-- Center: Slide Navigation Controls -->
            <div class="toolbar-center">
              <button type="button" class="tool-btn nav-btn" id="btn-first" title={t.firstPage} aria-label={t.firstPage}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="19 20 9 12 19 4 19 20"/>
                  <line x1="5" y1="19" x2="5" y2="5"/>
                </svg>
              </button>

              <button type="button" class="tool-btn nav-btn primary-nav" id="btn-prev" title={t.prevPage} aria-label={t.prevPage}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
                <span class="btn-label-mobile">{t.prevPage}</span>
              </button>

              <div class="page-jump-box">
                <span class="jump-label">{t.page}</span>
                <input type="number" id="page-input" min="1" max={totalPages} value="1" aria-label="Input nomor halaman" />
                <span class="jump-total">/ {totalPages}</span>
              </div>

              <button type="button" class="tool-btn nav-btn primary-nav" id="btn-next" title={t.nextPage} aria-label={t.nextPage}>
                <span class="btn-label-mobile">{t.nextPage}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </button>

              <button type="button" class="tool-btn nav-btn" id="btn-last" title={t.lastPage} aria-label={t.lastPage}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="5 4 15 12 5 20 5 4"/>
                  <line x1="19" y1="5" x2="19" y2="19"/>
                </svg>
              </button>
            </div>

            <!-- Right: Zoom, Thumbnails, Fullscreen -->
            <div class="toolbar-right">
              <button type="button" class="tool-btn" id="btn-zoom-out" title={t.zoomOut} aria-label={t.zoomOut}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
              </button>

              <button type="button" class="tool-btn zoom-level-pill" id="btn-zoom-fit" title={t.fitWidth}>
                <span id="zoom-text">100%</span>
              </button>

              <button type="button" class="tool-btn" id="btn-zoom-in" title={t.zoomIn} aria-label={t.zoomIn}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"/>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  <line x1="11" y1="8" x2="11" y2="14"/>
                  <line x1="8" y1="11" x2="14" y2="11"/>
                </svg>
              </button>

              <div class="toolbar-divider"></div>

              <button type="button" class="tool-btn" id="btn-toggle-thumbs" title={t.thumbnails} aria-label={t.thumbnails}>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                </svg>
              </button>

              <button type="button" class="tool-btn" id="btn-fullscreen" title={t.fullscreen} aria-label={t.fullscreen}>
                <svg id="icon-fs-enter" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                </svg>
                <svg id="icon-fs-exit" style="display:none;" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Thumbnail Drawer (Toggleable) -->
          <div class="deck-thumbnails-drawer" id="thumbnails-drawer" style="display:none;">
            <div class="thumbs-header">
              <span class="thumbs-title">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                </svg>
                {t.thumbnails} ({totalPages})
              </span>
              <button type="button" class="thumbs-close" id="btn-close-thumbs">✕</button>
            </div>
            <div class="thumbs-scroller" id="thumbs-scroller">
              {Array.from({ length: totalPages }).map((_, i) => (
                <button type="button" class="thumb-item" data-page={i + 1}>
                  <div class="thumb-canvas-box">
                    <span class="thumb-num">#{i + 1}</span>
                  </div>
                </button>
              ))}
            </div>
          </div>

          <!-- Main Canvas Presentation Viewport -->
          <div class="deck-viewport" id="deck-viewport">
            <!-- Loading Indicator -->
            <div class="deck-loading" id="deck-loading">
              <div class="spinner-box">
                <div class="deck-spinner"></div>
                <img src="/logocardi.png" alt="Cardi" class="spinner-logo" />
              </div>
              <p class="loading-title">{t.loading}</p>
              <p class="loading-sub">{t.loadingDesc}</p>
              <div class="loading-progress-bar">
                <div class="loading-bar-fill" id="loading-bar"></div>
              </div>
            </div>

            <!-- Canvas Element for PDF.js Rendering -->
            <div class="canvas-wrapper" id="canvas-wrapper">
              <canvas id="pdf-canvas"></canvas>
            </div>

            <!-- Native Fallback Container (hidden by default) -->
            <div class="deck-fallback" id="deck-fallback" style="display:none;">
              <div class="fallback-card">
                <h3>{t.fallbackNotice}</h3>
                <p>Silakan gunakan tombol di bawah untuk melihat dokumen dalam mode standar atau mengunduhnya langsung.</p>
                <div class="fallback-actions">
                  <a href={pdfUrl} target="_blank" rel="noopener" class="btn primary">{t.openNative}</a>
                  <a href={pdfUrl} download={downloadFilename} class="btn ghost">{t.actionDownload}</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Deck Footer Helper Bar -->
          <div class="deck-bottom-bar">
            <div class="bottom-tip">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <span>{t.tipKeyboard}</span>
            </div>

            <div class="bottom-actions">
              <button type="button" class="bottom-btn" id="btn-print-doc">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 6 2 18 2 18 9"/>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                  <rect x="6" y="14" width="12" height="8"/>
                </svg>
                {t.print}
              </button>

              <a href={pdfUrl} download={downloadFilename} class="bottom-btn highlight">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {t.actionDownload}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ QUICK CHAPTERS & JUMP TO SECTION (BENTO GRID) ============ -->
    {chapters.length > 0 && (
      <section class="deck-toc-section">
        <div class="wrap">
          <div class="section-header-box">
            <span class="section-eyebrow">{t.tocEyebrow}</span>
            <h2 class="section-heading">{t.tocTitle}</h2>
            <p class="section-lead">{t.tocDesc}</p>
          </div>

          <div class="chapters-grid">
            {chapters.map((ch) => (
              <div class="chapter-card" data-jump-page={ch.page}>
                <div class="chapter-card-top">
                  <span class="chapter-number">{ch.number}</span>
                  <span class="chapter-page-badge">{t.page} {ch.page}</span>
                </div>
                {ch.badge && <span class="chapter-tag">{ch.badge}</span>}
                <h3 class="chapter-title">{ch.title}</h3>
                <p class="chapter-desc">{ch.desc}</p>
                <button type="button" class="chapter-jump-btn" data-page={ch.page}>
                  <span>{t.jumpToPage} {ch.page}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </button>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ KEY STRATEGIC HIGHLIGHTS (BENTO GRID) ============ -->
    {highlights.length > 0 && (
      <section class="deck-summary-section">
        <div class="wrap">
          <div class="section-header-box">
            <span class="section-eyebrow">{t.summaryEyebrow}</span>
            <h2 class="section-heading">{t.summaryTitle}</h2>
          </div>

          <div class="highlights-grid">
            {highlights.map((h) => (
              <div class="highlight-card">
                <span class="highlight-tag">{h.tag}</span>
                <h3 class="highlight-title">{h.title}</h3>
                <p class="highlight-desc">{h.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ============ CALL TO ACTION BANNER ============ -->
    <section class="deck-cta-section">
      <div class="wrap">
        <div class="deck-cta-card">
          <div class="cta-glow"></div>
          <span class="cta-badge">{t.ctaEyebrow}</span>
          <h2 class="cta-heading">{t.ctaTitle}</h2>
