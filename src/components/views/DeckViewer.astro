<!-- Load PDF.js from official Cloudflare CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script is:inline define:vars={{ pdfUrl, totalPages, downloadFilename }}>
  (function () {
    // PDF.js worker setup
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    let pdfDoc = null;
    let pageNum = 1;
    let pageRendering = false;
    let pageNumPending = null;
    let scale = 1.0;
    let autoFit = true;
    const canvas = document.getElementById('pdf-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;

    const pageNumSpan = document.getElementById('page-num');
    const pageInput = document.getElementById('page-input');
    const pageCountSpan = document.getElementById('page-count');
    const loadingElem = document.getElementById('deck-loading');
    const loadingBar = document.getElementById('loading-bar');
    const zoomText = document.getElementById('zoom-text');
    const fallbackElem = document.getElementById('deck-fallback');
    const container = document.getElementById('deck-container');
    const viewport = document.getElementById('deck-viewport');
    const thumbsDrawer = document.getElementById('thumbnails-drawer');

    function updateActiveThumb(num) {
      const thumbs = document.querySelectorAll('.thumb-item');
      thumbs.forEach((t) => {
        if (parseInt(t.dataset.page, 10) === num) {
          t.classList.add('active');
          t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          t.classList.remove('active');
        }
      });
    }

    function calculateFitScale(page) {
      if (!viewport) return 1.0;
      const viewportWidth = viewport.clientWidth - (window.innerWidth <= 768 ? 24 : 48);
      const unscaledViewport = page.getViewport({ scale: 1.0 });
      let computed = viewportWidth / unscaledViewport.width;
      if (computed < 0.4) computed = 0.4;
      if (computed > 2.0) computed = 2.0;
      return computed;
    }

    function renderPage(num) {
      if (!pdfDoc || !ctx) return;
      pageRendering = true;

      pdfDoc.getPage(num).then(function (page) {
        if (autoFit) {
          scale = calculateFitScale(page);
        }

        const dpr = window.devicePixelRatio || 1;
        const currentViewport = page.getViewport({ scale: scale });

        canvas.height = Math.floor(currentViewport.height * dpr);
        canvas.width = Math.floor(currentViewport.width * dpr);
        canvas.style.height = Math.floor(currentViewport.height) + 'px';
        canvas.style.width = Math.floor(currentViewport.width) + 'px';

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const renderContext = {
          canvasContext: ctx,
          viewport: currentViewport
        };

        const renderTask = page.render(renderContext);

        renderTask.promise.then(function () {
          pageRendering = false;
          if (loadingElem) {
            loadingElem.style.display = 'none';
          }
          if (pageNumPending !== null) {
            renderPage(pageNumPending);
            pageNumPending = null;
          }
        }).catch(function (err) {
          pageRendering = false;
          console.error('Page render error:', err);
        });

        if (pageNumSpan) pageNumSpan.textContent = num;
        if (pageInput) pageInput.value = num;
        if (zoomText) zoomText.textContent = Math.round(scale * 100) + '%';
        updateActiveThumb(num);
      }).catch(function (err) {
        pageRendering = false;
        console.error('Get page error:', err);
      });
    }

    function queueRenderPage(num) {
      if (pageRendering) {
        pageNumPending = num;
      } else {
        renderPage(num);
      }
    }

    window.goToDeckPage = function (num) {
      if (!pdfDoc) {
        pageNum = num;
        return;
      }
      if (num < 1) num = 1;
      if (num > pdfDoc.numPages) num = pdfDoc.numPages;
      pageNum = num;
      queueRenderPage(pageNum);

      // Smooth scroll to viewer
      const anchor = document.getElementById('deck-viewer-anchor');
      if (anchor) {
        anchor.scrollIntoView({ behavior: 'smooth' });
      }
    };

    function onPrevPage() {
      if (pageNum <= 1) return;
      pageNum--;
      queueRenderPage(pageNum);
    }

    function onNextPage() {
      if (!pdfDoc || pageNum >= pdfDoc.numPages) return;
      pageNum++;
      queueRenderPage(pageNum);
    }

    function onFirstPage() {
      if (pageNum === 1) return;
      pageNum = 1;
      queueRenderPage(pageNum);
    }

    function onLastPage() {
      if (!pdfDoc || pageNum === pdfDoc.numPages) return;
      pageNum = pdfDoc.numPages;
      queueRenderPage(pageNum);
    }

    // Load PDF
    if (window.pdfjsLib) {
      const loadingTask = window.pdfjsLib.getDocument(pdfUrl);

      loadingTask.onProgress = function (progress) {
        if (progress.total && loadingBar) {
          const pct = Math.min(100, Math.round((progress.loaded / progress.total) * 100));
          loadingBar.style.width = pct + '%';
        }
      };

      loadingTask.promise.then(function (pdf) {
        pdfDoc = pdf;
        if (pageCountSpan) pageCountSpan.textContent = pdf.numPages;
        if (pageInput) pageInput.max = pdf.numPages;
        renderPage(pageNum);
      }).catch(function (error) {
        console.warn('PDF.js loading failed or blocked, activating fallback embed:', error);
        if (loadingElem) loadingElem.style.display = 'none';
        if (fallbackElem) fallbackElem.style.display = 'block';
        if (canvas) canvas.style.display = 'none';
      });
    } else {
      if (loadingElem) loadingElem.style.display = 'none';
      if (fallbackElem) fallbackElem.style.display = 'block';
    }

    // Event Listeners for Nav
    document.getElementById('btn-prev')?.addEventListener('click', onPrevPage);
    document.getElementById('btn-next')?.addEventListener('click', onNextPage);
    document.getElementById('btn-first')?.addEventListener('click', onFirstPage);
    document.getElementById('btn-last')?.addEventListener('click', onLastPage);

    // Page input
    pageInput?.addEventListener('change', function () {
      const val = parseInt(this.value, 10);
      if (!isNaN(val)) {
        window.goToDeckPage(val);
      }
    });

    pageInput?.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        const val = parseInt(this.value, 10);
        if (!isNaN(val)) {
          window.goToDeckPage(val);
        }
      }
    });

    // Zoom buttons
    document.getElementById('btn-zoom-in')?.addEventListener('click', function () {
      autoFit = false;
      scale = Math.min(2.5, scale + 0.15);
      queueRenderPage(pageNum);
    });

    document.getElementById('btn-zoom-out')?.addEventListener('click', function () {
      autoFit = false;
      scale = Math.max(0.4, scale - 0.15);
      queueRenderPage(pageNum);
    });

    document.getElementById('btn-zoom-fit')?.addEventListener('click', function () {
      autoFit = true;
      queueRenderPage(pageNum);
    });

    // Toggle thumbnails drawer
    document.getElementById('btn-toggle-thumbs')?.addEventListener('click', function () {
      if (!thumbsDrawer) return;
      const isOpen = thumbsDrawer.style.display !== 'none';
      thumbsDrawer.style.display = isOpen ? 'none' : 'block';
    });

    document.getElementById('btn-close-thumbs')?.addEventListener('click', function () {
      if (thumbsDrawer) thumbsDrawer.style.display = 'none';
    });

    // Thumbnail clicks
    document.querySelectorAll('.thumb-item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const p = parseInt(this.dataset.page, 10);
        if (!isNaN(p)) {
          window.goToDeckPage(p);
        }
      });
    });

    // Chapter buttons
    document.querySelectorAll('.chapter-jump-btn, .chapter-card').forEach(function (el) {
      el.addEventListener('click', function (e) {
        // Prevent double trigger if clicked directly on button inside card
        const page = parseInt(this.dataset.page || this.dataset.jumpPage, 10);
        if (!isNaN(page)) {
          window.goToDeckPage(page);
        }
      });
    });

    // Keyboard navigation
    window.addEventListener('keydown', function (e) {
      // Ignore if user is typing in an input
      if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        onNextPage();
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        onPrevPage();
      } else if (e.key === 'Home') {
        e.preventDefault();
        onFirstPage();
      } else if (e.key === 'End') {
        e.preventDefault();
        onLastPage();
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    // Swipe support for touch devices
    let touchStartX = 0;
    let touchStartY = 0;
    viewport?.addEventListener('touchstart', function (e) {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });

    viewport?.addEventListener('touchend', function (e) {
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      // Only handle horizontal swipes with small vertical deflection
      if (Math.abs(diffX) > 60 && Math.abs(diffY) < 50) {
        if (diffX < 0) {
          onNextPage();
        } else {
          onPrevPage();
        }
      }
    }, { passive: true });

    // Fullscreen Toggle
    function toggleFullscreen() {
      if (!container) return;
      if (!document.fullscreenElement) {
        if (container.requestFullscreen) {
          container.requestFullscreen();
        } else if (container.webkitRequestFullscreen) {
          container.webkitRequestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    }

    document.getElementById('btn-fullscreen')?.addEventListener('click', toggleFullscreen);

    document.addEventListener('fullscreenchange', function () {
      const isFs = !!document.fullscreenElement;
      container?.classList.toggle('is-fullscreen', isFs);
      const iconEnter = document.getElementById('icon-fs-enter');
      const iconExit = document.getElementById('icon-fs-exit');
      if (iconEnter && iconExit) {
        iconEnter.style.display = isFs ? 'none' : 'block';
        iconExit.style.display = isFs ? 'block' : 'none';
      }
      setTimeout(function () {
        autoFit = true;
        queueRenderPage(pageNum);
      }, 150);
    });

    // Resize listener with debounce
    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (autoFit && pdfDoc) {
          queueRenderPage(pageNum);
        }
      }, 200);
    });

    // Copy link button
    document.getElementById('btn-copy-link')?.addEventListener('click', function () {
      const textSpan = document.getElementById('copy-text');
      navigator.clipboard.writeText(window.location.href).then(function () {
        if (textSpan) {
          const original = textSpan.textContent;
          textSpan.textContent = 'Tersalin!';
          setTimeout(function () {
            textSpan.textContent = original;
          }, 2000);
        }
      }).catch(function () {});
    });

    // Print button
    document.getElementById('btn-print-doc')?.addEventListener('click', function () {
      const printWin = window.open(pdfUrl, '_blank');
      if (printWin) {
        printWin.focus();
        printWin.print();
      }
    });

    // Scroll to viewer button
    document.getElementById('btn-scroll-viewer')?.addEventListener('click', function (e) {
      e.preventDefault();
      document.getElementById('deck-viewer-anchor')?.scrollIntoView({ behavior: 'smooth' });
    });
  })();
</script>

