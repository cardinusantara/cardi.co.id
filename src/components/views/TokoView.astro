    p3Title: 'Produk AI & IT lainnya',
    p3Desc: 'Perangkat dan aksesori pendukung bisnis digital.',
    p3Foot: 'Ikuti TikTok Toko Cardi untuk rilis terbaru',
    partnerEyebrow: 'Program mitra',
    partnerHeading: 'Jual kartu Google Review di kotamu.',
    partnerDesc: 'Untuk reseller, agen, dan affiliator. Dapatkan harga khusus mitra serta panduan pemasaran lengkap.',
    partnerBtn: 'Daftar jadi mitra'
  },
  en: {
    title: 'Cardi Store — Ready-to-Use AI & IT Products',
    desc: 'AI & IT products from Cardi: NFC Google Review cards, NFC business cards, and more.',
    eyebrow: 'Cardi Store',
    heading: 'Ready-to-use AI & IT products for your business.',
    lead: 'One-time purchase, instant setup. Seamlessly connected to Cardi Agent applications.',
    btnOrder: 'Order LoyaL Card',
    btnOrderBadge: 'From IDR 69k',
    btnLearn: 'How It Works',
    btnShopee: 'Buy on Shopee',
    btnTokopedia: 'Buy on Tokopedia',
    btnTiktok: 'Official TikTok',
    btnWa: 'WhatsApp Support',
    secTitle: 'Product selection.',
    secEyebrow: 'Products',
    p1Tag: 'Best Seller',
    p1Title: 'NFC + QR Google Review Card',
    p1Desc: 'Customers simply tap or scan to open your business Google review page instantly. Powered by Cardi Agent AI Loyal.',
    p1Foot: 'Affordable for SMBs & Retailers',
    p1Link: 'Product details →',
    p2Title: 'NFC Smart Business Card',
    p2Desc: 'Tap to instantly share contact info and profile. Integrated with Cardi Agent AI MoM.',
    p2Foot: 'Personal & Corporate Packages',
    p2Link: 'Product details →',
    p3Tag: 'Coming Soon',
    p3Title: 'More AI & Hardware Products',
    p3Desc: 'Smart devices and essential accessories for modern digital businesses.',
    p3Foot: 'Follow TikTok Toko Cardi for upcoming releases',
    partnerEyebrow: 'Partner Program',
    partnerHeading: 'Distribute Google Review NFC cards in your city.',
    partnerDesc: 'For resellers, agencies, and affiliates. Access special partner pricing and comprehensive sales enablement.',
    partnerBtn: 'Become a Partner'
  },
  zh: {
    title: 'Cardi 官方商店 — 开箱即用的 AI 与 IT 产品',
    desc: 'Cardi AI 与 IT 产品：NFC 谷歌评价卡、NFC 智能名片等。',
    eyebrow: 'Cardi 商店',
    heading: '适用于企业的即用型 AI 与 IT 产品。',
    lead: '一次购买，立即可用。无缝连接 Cardi Agent 智能系统。',
    btnOrder: '订购 LoyaL 实体卡',
    btnOrderBadge: '69k 起',
    btnLearn: '运作方式',
    btnShopee: '在 Shopee 购买',
    btnTokopedia: '在 Tokopedia 购买',
    btnTiktok: '官方 TikTok',
    btnWa: 'WhatsApp 咨询',
    secTitle: '精选产品',
    secEyebrow: '产品系列',
    p1Tag: '热销',
    p1Title: 'NFC + QR 谷歌好评卡',
    p1Desc: '顾客只需轻触或扫码，即可直达谷歌评价页面。Cardi Agent AI Loyal 提供技术支持。',
    p1Foot: '中小企业与实体零售首选',
    p1Link: '产品详情 →',
    p2Title: 'NFC 智能商务名片',
    p2Desc: '轻碰即刻分享联系方式与商务主页。与 Cardi Agent AI MoM 深度集成。',
    p2Foot: '个人与企业定制方案',
    p2Link: '产品详情 →',
    p3Tag: '即将推出',
    p3Title: '更多 AI 与智能硬件产品',
    p3Desc: '支持数字化业务演进的智能硬件与配件。',
    p3Foot: '关注 Toko Cardi 抖音/TikTok 获悉首发资讯',
    partnerEyebrow: '合作伙伴计划',
    partnerHeading: '在您的城市代理销售 NFC 谷歌好评卡。',
    partnerDesc: '面向分销商、代理商与合作伙伴。尊享专属渠道价格与销售赋能资料。',
    partnerBtn: '申请成为合伙人'
  }
};

const c = copy[lang] || copy.id;
---

<Layout title={c.title} description={c.desc} lang={lang}>
  <Navbar lang={lang} />

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-copy">
          <span class="eyebrow">{c.eyebrow}</span>
          <h1>{c.heading}</h1>
          <p class="lead">{c.lead}</p>
          
          <div class="hero-actions">
            <!-- Action Button Cluster -->
            <div class="action-cluster">
              <a
                href="https://lynk.id/cardinusantara/qk553ykn87dd"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary-order"
              >
                <span>{c.btnOrder}</span>
                <span class="order-badge">{c.btnOrderBadge}</span>
              </a>

              <a href="#produk" class="btn-secondary-learn">
                <svg class="play-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{c.btnLearn}</span>
              </a>
            </div>

            <!-- Secondary Marketplace & Direct Action Row -->
            <div class="market-row">
              <a
                href="https://shopee.co.id/product/887001422/56118419469/"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/shopee-icon.svg" alt="Shopee" width="18" height="18" loading="lazy" />
                <span>{c.btnShopee}</span>
              </a>

              <a
                href="https://www.tokopedia.com/toko-cardi-agent/kartu-google-review-nfc-barcode-scan-google-maps-review-card-cafe-salon-barbershop-1737797533841785973?extParam=src%3Dshop%26whid%3D7691978422835513109&aff_unique_id=&channel=others&chain_key="
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/tokopedia-official.svg" alt="Tokopedia" width="18" height="18" loading="lazy" />
                <span>{c.btnTokopedia}</span>
              </a>

              <a
                href="https://www.tiktok.com/@cardiagent.ai?_r=1&_t=ZS-9AIQH0ySPZ9"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/tiktok-official.svg" alt="TikTok" width="18" height="18" loading="lazy" />
                <span>{c.btnTiktok}</span>
              </a>

              <a
                href="https://wa.me/6281289895646"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill light"
              >
                <img src="/icons/whatsapp-official.svg" alt="WhatsApp" width="18" height="18" loading="lazy" />
                <span>{c.btnWa}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Daftar Produk -->
    <section class="sec" id="produk">
      <div class="wrap">
        <div class="sec-head">
          <span class="eyebrow">{c.secEyebrow}</span>
          <h2>{c.secTitle}</h2>
        </div>
        <div class="grid g3">
          <article class="card">
            <div class="card-top">
              <span class="tag gold">{c.p1Tag}</span>
            </div>
            <h3>{c.p1Title}</h3>
            <p>{c.p1Desc}</p>
            <div class="card-foot">{c.p1Foot}</div>
            <a class="card-link" href="https://aiagent.cardi.co.id/cardiloyal/card/" target="_blank" rel="noopener">{c.p1Link}</a>
          </article>

          <article class="card">
            <div class="card-top"></div>
            <h3>{c.p2Title}</h3>
            <p>{c.p2Desc}</p>
            <div class="card-foot">{c.p2Foot}</div>
            <a class="card-link" href="https://aiagent.cardi.co.id/cardimom/card/" target="_blank" rel="noopener">{c.p2Link}</a>
          </article>

          <article class="card">
            <div class="card-top">
              <span class="tag soon">{c.p3Tag}</span>
            </div>
            <h3>{c.p3Title}</h3>
            <p>{c.p3Desc}</p>
            <div class="card-foot">{c.p3Foot}</div>
          </article>
        </div>
      </div>
    </section>

    <!-- Program Mitra -->
    <section class="sec sec-white">
      <div class="wrap">
        <div class="split">
          <div class="prose">
            <span class="eyebrow">{c.partnerEyebrow}</span>
            <h2 style="font-size:34px; color:var(--ink);">{c.partnerHeading}</h2>
            <p>{c.partnerDesc}</p>
            <a class="btn btn-dark" href="https://wa.me/6281289895646?text=Halo%20Toko%20Cardi%2C%20saya%20ingin%20jadi%20mitra%20reseller%20kartu%20Google%20Review%20NFC." target="_blank" rel="noopener" style="align-self:flex-start;">{c.partnerBtn}</a>
          </div>
          <div class="card" style="min-height:280px; display:flex; flex-direction:column; justify-content:center; align-items:center; background:var(--bg); border:1px dashed var(--line); border-radius:var(--radius-lg); text-align:center; padding:32px;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--blue)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:14px; opacity:0.85;">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <line x1="2" y1="10" x2="22" y2="10" />
            </svg>
            <span style="font-weight:700; color:var(--ink); font-size:16px;">Cardi Smart NFC Card Series</span>
            <p style="font-size:14px; color:var(--muted); max-width:320px; margin-top:6px;">Google Review Tap Card & Smart Contact Business Card with instant cloud synchronization.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .hero-actions {
    margin-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .action-cluster {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
  }

  @media (min-width: 640px) {
    .action-cluster {
      flex-direction: row;
      width: auto;
    }
  }

  .btn-primary-order {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 28px;
    border-radius: 9999px;
    background: #0F172A;
    color: #FFFFFF !important;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 10px 25px -4px rgba(15, 23, 42, 0.22), 0 4px 10px -2px rgba(15, 23, 42, 0.12);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 639px) {
    .btn-primary-order,
    .btn-secondary-learn {
      width: 100%;
      max-width: 340px;
    }
  }

  .btn-primary-order:hover {
    background: #020617;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 16px 32px -4px rgba(15, 23, 42, 0.35);
  }

  .order-badge {
    font-size: 11px;
    font-weight: 900;
    background: #EA580C;
    color: #FFFFFF;
    padding: 3px 10px;
    border-radius: 9999px;
    letter-spacing: -0.01em;
    transition: transform 0.2s ease;
  }

  .btn-primary-order:hover .order-badge {
    transform: scale(1.05);
  }

  .btn-secondary-learn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 26px;
    border-radius: 9999px;
    background: #FFFFFF;
    color: #0F172A !important;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid #E2E8F0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 48px;
  }

  .btn-secondary-learn:hover {
    background: #F8FAFC;
    border-color: #CBD5E1;
    color: #0F172A !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
  }

  .play-icon {
    width: 18px;
    height: 18px;
    color: #0F172A;
    flex-shrink: 0;
  }

  .market-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 4px;
    max-width: 680px;
  }

  .market-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 40px;
    user-select: none;
  }

  .market-pill img {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .market-pill.dark {
    background: #0F172A;
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .market-pill.dark:hover {
    background: #020617;
    color: #FFFFFF !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.18);
  }

  .market-pill.light {
    background: #FFFFFF;
    color: #0F172A !important;
    border: 1px solid #CBD5E1;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .market-pill.light:hover {
    background: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
  }
</style>
