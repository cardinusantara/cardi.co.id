const c = copy[lang] || copy.id;
---

<Layout title={c.title} description={c.desc} lang={lang}>
  <Navbar lang={lang} />

  <main id="main" class="toko-main">
    <!-- ==========================================
         1. HERO SECTION: RICH MODERN ARCHITECTURE
         ========================================== -->
    <section class="toko-hero">
      <div class="hero-ambient-glow" aria-hidden="true"></div>
      <div class="hero-dot-pattern" aria-hidden="true"></div>

      <div class="wrap hero-wrap">
        <div class="hero-copy">
          <!-- Eyebrow Pill Badge -->
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span class="badge-text">{c.eyebrow}</span>
          </div>

          <h1 class="hero-title">{c.heading}</h1>
          <p class="hero-lead">{c.lead}</p>
          
          <div class="hero-actions">
            <!-- Action Button Cluster -->
            <div class="action-cluster">
              <a
                href="https://lynk.id/cardinusantara/qk553ykn87dd"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary-order"
              >
                <span>{c.btnOrder}</span>
                <span class="order-badge">{c.btnOrderBadge}</span>
              </a>

              <a href="#produk" class="btn-secondary-learn">
                <svg class="play-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                    clip-rule="evenodd"
                  />
                </svg>
                <span>{c.btnLearn}</span>
              </a>
            </div>

            <!-- Secondary Marketplace & Direct Action Row -->
            <div class="market-row">
              <a
                href="https://shopee.co.id/product/887001422/56118419469/"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/shopee-icon.svg" alt="Shopee" width="18" height="18" loading="lazy" />
                <span>{c.btnShopee}</span>
              </a>

              <a
                href="https://www.tokopedia.com/toko-cardi-agent/kartu-google-review-nfc-barcode-scan-google-maps-review-card-cafe-salon-barbershop-1737797533841785973?extParam=src%3Dshop%26whid%3D7691978422835513109&aff_unique_id=&channel=others&chain_key="
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/tokopedia-official.svg" alt="Tokopedia" width="18" height="18" loading="lazy" />
                <span>{c.btnTokopedia}</span>
              </a>

              <a
                href="https://www.tiktok.com/@cardiagent.ai?_r=1&_t=ZS-9AIQH0ySPZ9"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill dark"
              >
                <img src="/icons/tiktok-official.svg" alt="TikTok" width="18" height="18" loading="lazy" />
                <span>{c.btnTiktok}</span>
              </a>

              <a
                href="https://wa.me/6281289895646"
                target="_blank"
                rel="noopener noreferrer"
                class="market-pill light"
              >
                <img src="/icons/whatsapp-official.svg" alt="WhatsApp" width="18" height="18" loading="lazy" />
                <span>{c.btnWa}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         2. HARDWARE TRUST & SPEC HIGHLIGHTS
         ========================================== -->
    <section class="sec-trust">
      <div class="wrap">
        <div class="trust-grid">
          <div class="trust-card">
            <div class="trust-icon-box orange">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <div class="trust-texts">
              <span class="trust-val">{c.trust1Val}</span>
              <span class="trust-lbl">{c.trust1Label}</span>
            </div>
          </div>

          <div class="trust-card">
            <div class="trust-icon-box blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
