---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import { getLangFromUrl } from '../../i18n/utils';
import type { LangKey } from '../../i18n/ui';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;

const copy = {
  id: {
    title: 'Toko Cardi — Produk AI & IT Siap Pakai',
    desc: 'Toko produk AI & IT dari Cardi: kartu Google Review NFC, kartu nama NFC, dan lainnya.',
    eyebrow: 'Toko Cardi',
    heading: 'Produk AI & IT siap pakai untuk bisnis.',
    lead: 'Dibeli sekali, langsung dipakai. Sebagian produk terhubung ke aplikasi Cardi Agent.',
    btnOrder: 'Pesan LoyaL Card',
    btnOrderBadge: 'Mulai 69rb',
    btnLearn: 'Pelajari Cara Kerja',
    btnShopee: 'Beli di Shopee',
    btnTokopedia: 'Beli di Tokopedia',
