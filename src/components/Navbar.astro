---
import LanguageSelector from './LanguageSelector.astro';
import SolutionsMegaMenu from './SolutionsMegaMenu.astro';
import ProductsMegaMenu from './ProductsMegaMenu.astro';
import SolutionIcon from './SolutionIcon.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';
import { solutionsData } from '../data/solutions';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHomePage = pathname === '/' || pathname === '/en' || pathname === '/zh';
---
<nav id="mainNav">
  <div class="navIn">
    <a class="brand" href={translatePath('/')} style="display:flex; align-items:center;">
      <img src="/logocardi.png" alt="Cardi" width="110" style="width:110px; height:auto; max-height:38px; display:block; object-fit:contain;" />
    </a>
    
    <!-- Desktop Menu -->
    <div class="menu">
      <!-- Produk & Layanan Dropdown -->
      <div class="menu-item">
        <a href="#produk">{t('nav.products')} <span class="car">▼</span></a>
        <ProductsMegaMenu lang={lang} />
      </div>

      <!-- Solusi Mega Dropdown -->
      <div class="menu-item">
        <a href={translatePath('/solusi')}>{t('nav.solutions')} <span class="car">▼</span></a>
        <SolutionsMegaMenu lang={lang} />
      </div>

      <a href={translatePath('/tentang-kami')}>{t('foot.about')}</a>
      <a href={translatePath('/ekosistem')}>{t('nav.ecosystem')}</a>
    </div>

    <!-- Desktop CTA & Language Switcher -->
    <div class="navR">
      <LanguageSelector currentLang={lang} />
      <a class="btn" href={translatePath('/cek-brand')} style="background:var(--blue); color:#fff; border-color:var(--blue); font-weight:700;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        {t('nav.checkBrand')}
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button class="burger-btn" id="burgerBtn" aria-label="Toggle navigation menu">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>
</nav>

<!-- Mobile Nav Drawer Overlay -->
<div class="mobile-nav-drawer" id="mobileNavDrawer">
  <div class="mobile-nav-content">
    
    <!-- Mobile Language Switcher Row -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding: 4px 16px 12px; border-bottom:1px solid var(--line);">
      <span style="font-size:13px; font-weight:700; color:var(--muted)">Bahasa / Language</span>
      <LanguageSelector currentLang={lang} />
    </div>

    <!-- Collapsible Accordion: Produk & Layanan -->
    <div class="mobile-menu-group">
      <button class="mobile-menu-trigger" type="button">
        <span>{t('nav.products')}</span>
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-accordion-body">
        <!-- Cardi Agent Section -->
        <div class="mob-section-title">
          <img src="/logos/lockups/cardi-agent.png" alt="Cardi Agent" style="height:20px; width:auto; object-fit:contain;" />
          <span class="mob-section-sub">Ekosistem AI</span>
        </div>
        <a href="https://aiagent.cardi.co.id/mom/" target="_blank" rel="noopener" class="mobile-sub-link">
          <span class="dLock">
            <img src="/logos/lockups/cardi-agent-mom.png" alt="Cardi Agent | MoM" style="height:18px; width:auto; object-fit:contain;" />
            <span style="font-size:11px;color:#94A3B8;margin-left:auto;">/mom/</span>
          </span>
          <small>Notulen meeting AI & kartu nama Smart NFC</small>
        </a>
        <a href="https://aiagent.cardi.co.id/loyal/" target="_blank" rel="noopener" class="mobile-sub-link">
          <span class="dLock">
            <img src="/logos/lockups/cardi-agent-loyal.png" alt="Cardi Agent | Loyal" style="height:18px; width:auto; object-fit:contain;" />
            <span style="font-size:11px;color:#94A3B8;margin-left:auto;">/loyal/</span>
          </span>
          <small>Member poin, reward & Google Review NFC</small>
        </a>
        <a href="https://aiagent.cardi.co.id/nadi/" target="_blank" rel="noopener" class="mobile-sub-link">
          <span class="dLock">
            <img src="/logos/lockups/cardi-agent-nadi.png" alt="Cardi Agent | Nadi" style="height:18px; width:auto; object-fit:contain;" />
            <span style="font-size:11px;color:#94A3B8;margin-left:auto;">/nadi/</span>
          </span>
          <small>AI operasional & pemantauan bisnis cerdas</small>
        </a>

        <!-- Cardi Nusantara Section -->
        <div class="mob-section-title" style="margin-top:14px;">
          <img src="/logos/lockups/cardi-nusantara.png" alt="Cardi Nusantara" style="height:20px; width:auto; object-fit:contain;" />
          <span class="mob-section-sub">Agensi Strategis</span>
        </div>
        <div class="mob-services-grid" style="grid-template-columns: 1fr;">
          <a href="https://cardinusantara.com/branding" target="_blank" rel="noopener" class="mob-service-card">
            <img src="/logos/lockups/cardi-branding.png" alt="Cardi Branding" style="height:18px; width:fit-content; object-fit:contain; margin-bottom:4px;" />
            <small>Identitas, strategi & diferensiasi brand</small>
          </a>
          <a href="https://cardinusantara.com/digital" target="_blank" rel="noopener" class="mob-service-card">
            <img src="/logos/lockups/cardi-digital.png" alt="Cardi Digital" style="height:18px; width:fit-content; object-fit:contain; margin-bottom:4px;" />
            <small>Konten, iklan performa & aktivasi digital</small>
          </a>
        </div>
      </div>
    </div>

    <!-- Collapsible Accordion: Solusi -->
    <div class="mobile-menu-group">
      <button class="mobile-menu-trigger" type="button">
        <span>{t('nav.solutions')}</span>
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-accordion-body">
        <a href={translatePath('/solusi')} class="mobile-sub-link" style="background:#EEF3FF; border-color:#C7D9FE;">
          <b>{t('solMenu.viewAll')}</b>
          <small>{t('solMenu.title')}</small>
        </a>
        {solutionsData.slice(0, 6).map(sol => (
          <a href={translatePath(`/solusi/${sol.slug}`)} class="mobile-sub-link">
            <span class="dLock">
              <span style="display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; color:var(--blue); margin-right:6px; flex-shrink:0;">
                <SolutionIcon name={sol.icon} size={18} />
              </span>
              <b>{sol.title[lang] || sol.title.id}</b>
            </span>
            <small>{sol.desc[lang] || sol.desc.id}</small>
          </a>
        ))}
      </div>
    </div>

    <a href={translatePath('/tentang-kami')} class="mobile-nav-link">{t('foot.about')}</a>
    <a href={translatePath('/ekosistem')} class="mobile-nav-link">{t('nav.ecosystem')}</a>

    <!-- Mobile CTA Button -->
    <div class="mobile-nav-cta">
      <a class="btn" href={translatePath('/cek-brand')} style="width:100%; justify-content:center; background:var(--blue); color:#fff; border-color:var(--blue); font-weight:700;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        {t('nav.checkBrand')}
      </a>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileNavDrawer');
    const accordionTriggers = document.querySelectorAll('.mobile-menu-trigger');

    if (burgerBtn && mobileDrawer) {
      burgerBtn.addEventListener('click', () => {
        const isOpen = burgerBtn.classList.toggle('active');
        mobileDrawer.classList.toggle('open', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      // Close drawer when clicking any navigation link
      const mobileLinks = mobileDrawer.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          burgerBtn.classList.remove('active');
          mobileDrawer.classList.remove('open');
          document.body.style.overflow = '';
        });
      });
    }

    // Collapsible Accordion logic for Mobile Menu
    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const group = trigger.closest('.mobile-menu-group');
        if (group) {
          group.classList.toggle('expanded');
        }
      });
    });
  });
</script>

<style>
  .mob-section-title {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 4px 4px;
    margin-bottom: 2px;
  }
  .mob-section-title b {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--ink, #0A1633);
  }
  .mob-section-sub {
    font-size: 11px;
    color: var(--muted, #64748B);
    margin-left: auto;
  }
  .mob-services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mob-service-card {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    background: #ffffff;
    border: 1px solid var(--line, #E2E8F0);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .mob-service-card:hover {
    border-color: #0B63C5;
    background: #F8FAFC;
  }
  .mob-service-card b {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink, #0A1633);
    line-height: 1.2;
  }
  .mob-service-card small {
    font-size: 11px;
    color: var(--muted, #64748B);
    margin-top: 2px;
    line-height: 1.3;
  }
</style>
