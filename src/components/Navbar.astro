---
import LanguageSelector from './LanguageSelector.astro';
import SolutionsMegaMenu from './SolutionsMegaMenu.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import type { LangKey } from '../i18n/ui';
import { solutionsData } from '../data/solutions';

interface Props {
  lang?: LangKey;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<nav id="mainNav">
  <div class="navIn">
    <a class="brand" href={translatePath('/')} style="display:flex; align-items:center;">
      <img src="/logocardi.png" alt="Cardi" width="110" style="width:110px; height:auto; max-height:38px; display:block; object-fit:contain;" />
    </a>
    
    <!-- Desktop Menu -->
    <div class="menu">
      <!-- Produk & Layanan Dropdown -->
      <div class="menu-item">
        <a href="#produk">{t('nav.products')} <span class="car">▼</span></a>
        <div class="dropdown wide">
          <a href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener">
            <span class="dLock">
              <svg width="22" height="22" viewBox="0 0 120 120" fill="none">
                <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#1e4fff"
                  transform="translate(66 60) rotate(90) scale(1.3) translate(-60 -38)" />
                <circle cx="26" cy="60" r="8" fill="#1e4fff" />
              </svg>
              <span class="dTx"><small>cardi</small><b>ai agent</b></span>
            </span>
            <span class="dDesc">{t('nav.agentDesc')}</span>
          </a>
          <a href="https://cardinusantara.com/" target="_blank">
            <span class="dLock">
              <svg width="22" height="22" viewBox="0 0 120 120" fill="none">
                <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#0A1633"
                  transform="translate(60 60) rotate(45) scale(1.3) translate(-60 -38)" />
              </svg>
              <span class="dTx"><small>cardi</small><b>nusantara</b></span>
            </span>
            <span class="dDesc">{t('nav.nusantaraDesc')}</span>
          </a>
        </div>
      </div>

      <!-- Solusi Mega Dropdown -->
      <div class="menu-item">
        <a href={translatePath('/solusi')}>{t('nav.solutions')} <span class="car">▼</span></a>
        <SolutionsMegaMenu lang={lang} />
      </div>

      <a href={translatePath('/tentang-kami')}>{t('foot.about')}</a>
      <a href={translatePath('/ekosistem')}>{t('nav.ecosystem')}</a>
      <a href={translatePath('/toko')}>{t('foot.shop')}</a>
    </div>

    <!-- Desktop CTA & Language Switcher -->
    <div class="navR">
      <LanguageSelector currentLang={lang} />
      <a class="btn" href={translatePath('/cek-brand')} style="background:var(--blue); color:#fff; border-color:var(--blue); font-weight:700;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        {t('nav.checkBrand')}
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button class="burger-btn" id="burgerBtn" aria-label="Toggle navigation menu">
      <span class="bar bar-1"></span>
      <span class="bar bar-2"></span>
      <span class="bar bar-3"></span>
    </button>
  </div>
</nav>

<!-- Mobile Nav Drawer Overlay -->
<div class="mobile-nav-drawer" id="mobileNavDrawer">
  <div class="mobile-nav-content">
    
    <!-- Mobile Language Switcher Row -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding: 4px 16px 12px; border-bottom:1px solid var(--line);">
      <span style="font-size:13px; font-weight:700; color:var(--muted)">Bahasa / Language</span>
      <LanguageSelector currentLang={lang} />
    </div>

    <!-- Collapsible Accordion: Produk & Layanan -->
    <div class="mobile-menu-group">
      <button class="mobile-menu-trigger" type="button">
        <span>{t('nav.products')}</span>
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-accordion-body">
        <a href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener" class="mobile-sub-link">
          <span class="dLock">
            <svg width="20" height="20" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#1e4fff" transform="translate(66 60) rotate(90) scale(1.3) translate(-60 -38)" />
              <circle cx="26" cy="60" r="8" fill="#1e4fff" />
            </svg>
            <b>Cardi AI Agent</b>
          </span>
          <small>{t('nav.agentDesc')}</small>
        </a>
        <a href="https://cardinusantara.com/" target="_blank" class="mobile-sub-link">
          <span class="dLock">
            <svg width="20" height="20" viewBox="0 0 120 120" fill="none">
              <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#0A1633" transform="translate(60 60) rotate(45) scale(1.3) translate(-60 -38)" />
            </svg>
            <b>Cardi Nusantara</b>
          </span>
          <small>{t('nav.nusantaraDesc')}</small>
        </a>
      </div>
    </div>

    <!-- Collapsible Accordion: Solusi -->
    <div class="mobile-menu-group">
      <button class="mobile-menu-trigger" type="button">
        <span>{t('nav.solutions')}</span>
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="mobile-accordion-body">
        <a href={translatePath('/solusi')} class="mobile-sub-link" style="background:#EEF3FF; border-color:#C7D9FE;">
          <b>{t('solMenu.viewAll')}</b>
          <small>{t('solMenu.title')}</small>
        </a>
        {solutionsData.slice(0, 6).map(sol => (
          <a href={translatePath(`/solusi/${sol.slug}`)} class="mobile-sub-link">
            <span class="dLock">
              <span style="font-size:16px; margin-right:4px;">{sol.icon}</span>
              <b>{sol.title[lang] || sol.title.id}</b>
            </span>
            <small>{sol.desc[lang] || sol.desc.id}</small>
          </a>
        ))}
      </div>
    </div>

    <a href={translatePath('/tentang-kami')} class="mobile-nav-link">{t('foot.about')}</a>
    <a href={translatePath('/ekosistem')} class="mobile-nav-link">{t('nav.ecosystem')}</a>
    <a href={translatePath('/toko')} class="mobile-nav-link">{t('foot.shop')}</a>

    <!-- Mobile CTA Button -->
    <div class="mobile-nav-cta">
      <a class="btn" href={translatePath('/cek-brand')} style="width:100%; justify-content:center; background:var(--blue); color:#fff; border-color:var(--blue); font-weight:700;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        {t('nav.checkBrand')}
      </a>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const burgerBtn = document.getElementById('burgerBtn');
    const mobileDrawer = document.getElementById('mobileNavDrawer');
    const accordionTriggers = document.querySelectorAll('.mobile-menu-trigger');

    if (burgerBtn && mobileDrawer) {
      burgerBtn.addEventListener('click', () => {
        const isOpen = burgerBtn.classList.toggle('active');
        mobileDrawer.classList.toggle('open', isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      // Close drawer when clicking any navigation link
      const mobileLinks = mobileDrawer.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          burgerBtn.classList.remove('active');
          mobileDrawer.classList.remove('open');
          document.body.style.overflow = '';
        });
      });
    }

    // Collapsible Accordion logic for Mobile Menu
    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const group = trigger.closest('.mobile-menu-group');
        if (group) {
          group.classList.toggle('expanded');
        }
      });
    });
  });
</script>
