---
import rawHtml from '../components/nusantara-agent-ai.html?raw';

const headInject = `
<link rel="icon" type="image/png" href="/40.png" />
<link rel="apple-touch-icon" href="/40.png" />
<style>
  /* Floating WhatsApp Button */
  .cardi-wa-float {
    position: fixed !important;
    right: 24px !important;
    bottom: 24px !important;
    z-index: 2147483647 !important;
    width: 58px !important;
    height: 58px !important;
    border-radius: 50% !important;
    background-color: #25D366 !important;
    color: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.38) !important;
    text-decoration: none !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
  }
  .cardi-wa-float:hover {
    background-color: #1ebe5d !important;
    transform: translateY(-3px) scale(1.04) !important;
    box-shadow: 0 12px 28px rgba(37, 211, 102, 0.48) !important;
  }
  .cardi-wa-float svg {
    width: 31px !important;
    height: 31px !important;
    fill: #ffffff !important;
    display: block !important;
  }

  /* 3-Language Switcher */
  .cardi-lang-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .cardi-lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 38px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    color: #0f172a;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .cardi-lang-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }
  .cardi-lang-flag {
    width: 22px;
    height: 15px;
    border-radius: 3px;
    overflow: hidden;
    display: inline-flex;
    flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.14);
  }
  .cardi-lang-flag svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .cardi-lang-chevron {
    width: 14px;
    height: 14px;
    color: #64748b;
    transition: transform 0.2s ease;
  }
  .cardi-lang-wrap.open .cardi-lang-chevron {
    transform: rotate(180deg);
  }
  .cardi-lang-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 196px;
    padding: 8px;
    border-radius: 16px;
    background: #ffffff;
    border: 1px solid rgba(15, 23, 42, 0.08);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.14);
    display: none;
    flex-direction: column;
    gap: 4px;
    z-index: 2147483646;
  }
  .cardi-lang-wrap.open .cardi-lang-menu {
    display: flex;
  }
  .cardi-lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 10px 12px;
    border: none;
    border-radius: 11px;
    background: transparent;
    color: #1e293b;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .cardi-lang-item:hover {
    background: #f8fafc;
  }
  .cardi-lang-item.active {
    background: #f3f0ff;
    color: #4f46e5;
    font-weight: 600;
  }
  .cardi-lang-item-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cardi-lang-check {
    width: 16px;
    height: 16px;
    color: #4f46e5;
    opacity: 0;
  }
  .cardi-lang-item.active .cardi-lang-check {
    opacity: 1;
  }

  /* Scoped Embeddable Styles: Portofolio, Industry Experience & Studi Kasus */
  .cardi-embed-wrapper {
    --cn-primary: #1d4ed8;
    --cn-primary-dark: #1e40af;
    --cn-primary-light: #eff6ff;
    --cn-primary-border: #bfdbfe;
    --cn-text-dark: #0f172a;
    --cn-text-muted: #475569;
    --cn-text-subtle: #64748b;
    --cn-bg-soft: #f8fafc;
    --cn-border: #e2e8f0;
    --cn-radius-lg: 20px;
    --cn-radius-md: 14px;
    font-family: inherit;
    color: var(--cn-text-dark);
    line-height: 1.6;
    box-sizing: border-box;
    background: #ffffff;
  }
  .cardi-embed-wrapper *,
  .cardi-embed-wrapper *::before,
  .cardi-embed-wrapper *::after {
    box-sizing: border-box;
  }
  .cn-section {
    padding: 72px 20px;
  }
  .cn-section-soft {
    background-color: var(--cn-bg-soft);
    border-top: 1px solid var(--cn-border);
    border-bottom: 1px solid var(--cn-border);
  }
  .cn-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .cn-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 40px;
  }
  .cn-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--cn-primary-light);
    color: var(--cn-primary);
    border: 1px solid var(--cn-primary-border);
    font-size: 13px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
    letter-spacing: 0.02em;
  }
  .cn-title {
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 800;
    color: var(--cn-text-dark);
    margin: 0 0 12px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .cn-subtitle {
    font-size: 16px;
    color: var(--cn-text-muted);
    margin: 0;
  }
  .cn-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 36px;
  }
  .cn-filter-btn {
    background: #ffffff;
    border: 1px solid var(--cn-border);
    color: var(--cn-text-muted);
    padding: 9px 18px;
    border-radius: 999px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cn-filter-btn:hover {
    border-color: var(--cn-primary);
    color: var(--cn-primary);
  }
  .cn-filter-btn.active {
    background: var(--cn-primary);
    border-color: var(--cn-primary);
    color: #ffffff;
    box-shadow: 0 6px 16px rgba(29, 78, 216, 0.2);
  }
  .cn-portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 24px;
  }
  .cn-card {
    background: #ffffff;
    border: 1px solid var(--cn-border);
    border-radius: var(--cn-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .cn-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
    border-color: var(--cn-primary-border);
  }
  .cn-card.hidden {
    display: none;
  }
  .cn-card-thumb {
    position: relative;
    height: 196px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }
  .cn-card-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .cn-card:hover .cn-card-thumb img {
    transform: scale(1.04);
  }
  .cn-card-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.65) 0%, rgba(15, 23, 42, 0.05) 60%);
  }
  .cn-thumb-badges {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
    justify-content: space-between;
    align-items: center;
  }
  .cn-badge-cat {
    background: rgba(255, 255, 255, 0.94);
    color: var(--cn-text-dark);
    font-size: 12px;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: 999px;
  }
  .cn-badge-new {
    background: var(--cn-primary);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 10px;
    border-radius: 999px;
  }
  .cn-card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .cn-card-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 4px;
    color: var(--cn-text-dark);
  }
  .cn-card-meta {
    font-size: 13px;
    font-weight: 600;
    color: var(--cn-primary);
    margin: 0 0 12px;
  }
  .cn-card-desc {
    font-size: 14px;
    color: var(--cn-text-muted);
    margin: 0 0 20px;
    flex: 1;
  }
  .cn-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--cn-border);
  }
  .cn-btn-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--cn-text-dark);
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: color 0.2s;
  }
  .cn-btn-link:hover {
    color: var(--cn-primary);
  }
  .cn-btn-order {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--cn-primary-light);
    color: var(--cn-primary);
    border: 1px solid var(--cn-primary-border);
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }
  .cn-btn-order:hover {
    background: var(--cn-primary);
    color: #ffffff;
  }
  .cn-search-box {
    max-width: 480px;
    margin: 0 auto 32px;
    position: relative;
  }
  .cn-search-input {
    width: 100%;
    padding: 13px 18px 13px 44px;
    border-radius: 999px;
    border: 1px solid var(--cn-border);
    background: #ffffff;
    font-family: inherit;
    font-size: 14px;
    color: var(--cn-text-dark);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .cn-search-input:focus {
    border-color: var(--cn-primary);
    box-shadow: 0 0 0 4px rgba(29, 78, 216, 0.1);
  }
  .cn-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    pointer-events: none;
  }
  .cn-industry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
    gap: 16px;
  }
  .cn-ind-card {
    background: #ffffff;
    border: 1px solid var(--cn-border);
    border-radius: var(--cn-radius-md);
    padding: 18px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .cn-ind-card:hover {
    border-color: var(--cn-primary-border);
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.05);
    transform: translateY(-2px);
  }
  .cn-ind-card.hidden {
    display: none;
  }
  .cn-ind-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .cn-ind-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--cn-primary-light);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 19px;
    flex-shrink: 0;
  }
  .cn-ind-name {
    font-size: 16px;
    font-weight: 700;
    margin: 0;
    color: var(--cn-text-dark);
  }
  .cn-ind-desc {
    font-size: 13px;
    color: var(--cn-text-muted);
    margin: 0;
    line-height: 1.55;
  }
  .cn-testi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
    gap: 24px;
  }
  .cn-testi-card {
    background: #ffffff;
    border: 1px solid var(--cn-border);
    border-radius: var(--cn-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .cn-testi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(15, 23, 42, 0.07);
  }
  .cn-testi-img {
    height: 170px;
    width: 100%;
    object-fit: cover;
    background: #e2e8f0;
  }
  .cn-testi-body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .cn-testi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }
  .cn-testi-tag {
    background: var(--cn-primary-light);
    color: var(--cn-primary);
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .cn-testi-stars {
    color: #2563eb;
    font-size: 14px;
    letter-spacing: 1px;
  }
  .cn-testi-quote {
    font-size: 14px;
    color: var(--cn-text-dark);
    margin: 0 0 16px;
    flex: 1;
    line-height: 1.6;
  }
  .cn-testi-role {
    font-size: 13px;
    font-weight: 700;
    color: var(--cn-text-subtle);
    margin: 0;
  }
  .cn-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    z-index: 2147483645;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .cn-modal-backdrop.open {
    display: flex;
  }
  .cn-modal-box {
    background: #ffffff;
    border-radius: 20px;
    max-width: 520px;
    width: 100%;
    padding: 28px;
    box-shadow: 0 24px 48px rgba(15, 23, 42, 0.2);
    position: relative;
  }
  .cn-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--cn-border);
    background: var(--cn-bg-soft);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cn-text-dark);
  }
  .cn-modal-close:hover {
    background: #e2e8f0;
  }
  .cn-modal-list {
    margin: 16px 0 24px;
    padding-left: 20px;
    color: var(--cn-text-muted);
    font-size: 14px;
  }
  .cn-modal-list li {
    margin-bottom: 8px;
  }
  .cn-modal-cta {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--cn-primary);
    color: #ffffff;
    padding: 13px 20px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cn-modal-cta:hover {
    background: var(--cn-primary-dark);
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .cardi-lang-wrap {
      margin: 6px 0;
    }
    .cardi-lang-menu {
      left: 0;
      right: auto;
    }
    .cardi-wa-float {
      right: 16px !important;
      bottom: 16px !important;
      width: 52px !important;
      height: 52px !important;
    }
  }
</style>
`;

