  '        \'<span class="cardi-lang-flag" id="cardi-active-flag">\' + FLAGS.id + \'</span>\' +',
  '        \'<svg class="cardi-lang-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 7.5L10 12.5L15 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>\' +',
  '      \'</button>\' +',
  '      \'<div class="cardi-lang-menu" role="listbox">\' +',
  '        \'<button type="button" class="cardi-lang-item active" data-lang="id"><span class="cardi-lang-item-left"><span class="cardi-lang-flag">\' + FLAGS.id + \'</span><span>Indonesia</span></span><svg class="cardi-lang-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4.5 10.5L8.2 14.2L15.5 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>\' +',
  '        \'<button type="button" class="cardi-lang-item" data-lang="en"><span class="cardi-lang-item-left"><span class="cardi-lang-flag">\' + FLAGS.en + \'</span><span>English</span></span><svg class="cardi-lang-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4.5 10.5L8.2 14.2L15.5 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>\' +',
  '        \'<button type="button" class="cardi-lang-item" data-lang="zh"><span class="cardi-lang-item-left"><span class="cardi-lang-flag">\' + FLAGS.zh + \'</span><span>中文</span></span><svg class="cardi-lang-check" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4.5 10.5L8.2 14.2L15.5 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>\' +',
  '      \'</div>\';',
  '    var paketLink = navLinks.querySelector(\'a[href="#paket"]\');',
  '    var loginLink = navLinks.querySelector(\'.nav-login, a[href*="login"]\');',
  '    if (paketLink && paketLink.nextSibling) {',
  '      navLinks.insertBefore(wrap, paketLink.nextSibling);',
  '    } else if (loginLink) {',
  '      navLinks.insertBefore(wrap, loginLink);',
  '    } else {',
  '      navLinks.appendChild(wrap);',
  '    }',
  '    var toggleBtn = wrap.querySelector(".cardi-lang-btn");',
  '    toggleBtn.addEventListener("click", function(e) {',
  '      e.stopPropagation();',
  '      var isOpen = wrap.classList.toggle("open");',
  '      toggleBtn.setAttribute("aria-expanded", String(isOpen));',
  '    });',
  '    var items = wrap.querySelectorAll(".cardi-lang-item");',
  '    for (var k = 0; k < items.length; k++) {',
  '      items[k].addEventListener("click", function() {',
  '        applyLang(this.getAttribute("data-lang"));',
  '        wrap.classList.remove("open");',
  '        toggleBtn.setAttribute("aria-expanded", "false");',
  '      });',
  '    }',
  '    document.addEventListener("click", function(e) {',
  '      if (!wrap.contains(e.target)) {',
  '        wrap.classList.remove("open");',
  '        toggleBtn.setAttribute("aria-expanded", "false");',
  '      }',
  '    });',
  '  }',
  '  var savedLang = "id";',
  '  try { savedLang = localStorage.getItem("cardi_lang") || "id"; } catch (e) {}',
  '  if (savedLang !== "id" && FLAGS[savedLang]) applyLang(savedLang);',
  '})();',
  '<' + '/script>'
].join('\n');

const cleanedHtml = rawHtml.replace(/<link[^>]*rel=["'](?:shortcut )?icon["'][^>]*>/gi, '');

const withHead = /<\/head>/i.test(cleanedHtml)
  ? cleanedHtml.replace(/<\/head>/i, () => `${headInject}\n</head>`)
  : `${headInject}\n${cleanedHtml}`;

// Sisipkan 3 bagian baru tepat di atas "CARA KERJA / Mulai dari Brand Check Up."
const markerIdx = withHead.indexOf('Mulai dari Brand Check Up');
const fallbackIdx = withHead.indexOf('Siap tumbuh bersama Cardi?');
const targetIdx = markerIdx !== -1 ? markerIdx : fallbackIdx;

let withSections = withHead;
if (targetIdx !== -1) {
  const sectionStart = withHead.lastIndexOf('<section', targetIdx);
  if (sectionStart !== -1) {
    withSections =
      withHead.slice(0, sectionStart) +
      embedSectionHtml +
      '\n' +
      withHead.slice(sectionStart);
  }
}

const finalHtml = /<\/body>/i.test(withSections)
  ? withSections.replace(/<\/body>/i, () => `${bodyInject}\n</body>`)
  : `${withSections}\n${bodyInject}`;
---

<Fragment set:html={finalHtml} />
