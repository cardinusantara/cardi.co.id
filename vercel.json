{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/agent", "destination": "https://aiagent.cardi.co.id", "permanent": true },
    { "source": "/en/agent", "destination": "https://aiagent.cardi.co.id", "permanent": true },
    { "source": "/zh/agent", "destination": "https://aiagent.cardi.co.id", "permanent": true },
    { "source": "/mom", "destination": "https://aiagent.cardi.co.id/mom", "permanent": true },
    { "source": "/en/mom", "destination": "https://aiagent.cardi.co.id/mom", "permanent": true },
    { "source": "/zh/mom", "destination": "https://aiagent.cardi.co.id/mom", "permanent": true },
    { "source": "/plugin", "destination": "/ekosistem", "permanent": true },
    { "source": "/en/plugin", "destination": "/en/ekosistem", "permanent": true },
    { "source": "/zh/plugin", "destination": "/zh/ekosistem", "permanent": true },
    { "source": "/blog", "destination": "/insight", "permanent": true },
    { "source": "/en/blog", "destination": "/en/insight", "permanent": true },
    { "source": "/zh/blog", "destination": "/zh/insight", "permanent": true },
    { "source": "/company-profile.pdf", "destination": "/company-profile", "permanent": true }
  ],
  "headers": [
    {
      "source": "/Cardi%20-%20Quotation%20&%20Offering%20for%20Brands.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Cardi - Quotation & Offering for Brands.pdf\"" }
      ]
    },
    {
      "source": "/Cardi.co.id%20-%20Pricing.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Cardi.co.id - Pricing.pdf\"" }
      ]
    }
  ]
}